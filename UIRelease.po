#. Key:	KEY_METAGAME_SETTINGS_MOTIONBLUR_DESCRIPTION
#. SourceLocation:	/Game/BASE/UI/_Shared/ST_Settings.ST_Settings
#. InfoMetaData:	"Notes Localization" : "setting 85 description"
#: /Game/BASE/UI/_Shared/ST_Settings.ST_Settings
msgctxt "ST_Settings,KEY_METAGAME_SETTINGS_MOTIONBLUR_DESCRIPTION"
msgid ""
"Enable to simulate the blurring of fast-moving objects. It might reduce "
"clarity and add visual clutter, but it can help the game feel smoother at "
"lower frame rates."
msgstr ""
"Simuluje rozmazání rychle se pohybujících objektů. Obraz může být méně ostrý"
" a přehledný, ale při nižší snímkové frekvenci může působit plynuleji."

#. Key:	KEY_METAGAME_SETTINGS_MOTIONBLUR_NAME
#. SourceLocation:	/Game/BASE/UI/_Shared/ST_Settings.ST_Settings
#. InfoMetaData:	"Notes Localization" : "setting 85 name"
#: /Game/BASE/UI/_Shared/ST_Settings.ST_Settings
msgctxt "ST_Settings,KEY_METAGAME_SETTINGS_MOTIONBLUR_NAME"
msgid "Motion blur"
msgstr "Rozmazání pohybu"

#. Key:	KEY_METAGAME_SETTINGS_MOUSESENSITIVITYHORIZONTAL_DESCRIPTION
#. SourceLocation:	/Game/BASE/UI/_Shared/ST_Settings.ST_Settings
#. InfoMetaData:	"Notes Localization" : "setting 86 description"
#: /Game/BASE/UI/_Shared/ST_Settings.ST_Settings
msgctxt ""
"ST_Settings,KEY_METAGAME_SETTINGS_MOUSESENSITIVITYHORIZONTAL_DESCRIPTION"
msgid ""
"Horizontal sensitivity for looking around when playing the game with a "
"mouse. This setting only adjusts the horizontal axis, multiplying the base "
"sensitivity setting."
msgstr ""
"Vodorovná citlivost rozhlížení při ovládání myší. Násobí základní citlivost "
"a upravuje pouze vodorovnou osu."

#. Key:	KEY_METAGAME_SETTINGS_MOUSESENSITIVITYHORIZONTAL_NAME
#. SourceLocation:	/Game/BASE/UI/_Shared/ST_Settings.ST_Settings
#. InfoMetaData:	"Notes Localization" : "setting 86 name"
#: /Game/BASE/UI/_Shared/ST_Settings.ST_Settings
msgctxt "ST_Settings,KEY_METAGAME_SETTINGS_MOUSESENSITIVITYHORIZONTAL_NAME"
msgid "Look : horizontal"
msgstr "Rozhlížení: vodorovně"

#. Key:	KEY_METAGAME_SETTINGS_MOUSESENSITIVITYLOOK_DESCRIPTION
#. SourceLocation:	/Game/BASE/UI/_Shared/ST_Settings.ST_Settings
#. InfoMetaData:	"Notes Localization" : "setting 87 description"
#: /Game/BASE/UI/_Shared/ST_Settings.ST_Settings
msgctxt "ST_Settings,KEY_METAGAME_SETTINGS_MOUSESENSITIVITYLOOK_DESCRIPTION"
msgid ""
"Base sensitivity for looking around and using ADS when controlling the game "
"with a mouse."
msgstr "Základní citlivost rozhlížení a míření při ovládání myší."

#. Key:	KEY_METAGAME_SETTINGS_MOUSESENSITIVITYLOOK_NAME
#. SourceLocation:	/Game/BASE/UI/_Shared/ST_Settings.ST_Settings
#. InfoMetaData:	"Notes Localization" : "setting 87 name"
#: /Game/BASE/UI/_Shared/ST_Settings.ST_Settings
msgctxt "ST_Settings,KEY_METAGAME_SETTINGS_MOUSESENSITIVITYLOOK_NAME"
msgid "Base"
msgstr "Základní citlivost"

#. Key:	KEY_METAGAME_SETTINGS_MOUSESENSITIVITYVERTICAL_DESCRIPTION
#. SourceLocation:	/Game/BASE/UI/_Shared/ST_Settings.ST_Settings
#. InfoMetaData:	"Notes Localization" : "setting 88 description"
#: /Game/BASE/UI/_Shared/ST_Settings.ST_Settings
msgctxt ""
"ST_Settings,KEY_METAGAME_SETTINGS_MOUSESENSITIVITYVERTICAL_DESCRIPTION"
msgid ""
"Vertical sensitivity for looking around when playing the game with a mouse. "
"This setting only adjusts the vertical axis, multiplying the base "
"sensitivity setting."
msgstr ""
"Svislá citlivost rozhlížení při ovládání myší. Násobí základní citlivost a "
"upravuje pouze svislou osu."

#. Key:	KEY_METAGAME_SETTINGS_MOUSESENSITIVITYVERTICAL_NAME
#. SourceLocation:	/Game/BASE/UI/_Shared/ST_Settings.ST_Settings
#. InfoMetaData:	"Notes Localization" : "setting 88 name"
#: /Game/BASE/UI/_Shared/ST_Settings.ST_Settings
msgctxt "ST_Settings,KEY_METAGAME_SETTINGS_MOUSESENSITIVITYVERTICAL_NAME"
msgid "Look : vertical"
msgstr "Rozhlížení: svisle"

#. Key:	KEY_METAGAME_SETTINGS_NOISEVISIBILITYWIND_DESCRIPTION
#. SourceLocation:	/Game/BASE/UI/_Shared/ST_Settings.ST_Settings
#. InfoMetaData:	"Notes Localization" : "setting 116 description"
#: /Game/BASE/UI/_Shared/ST_Settings.ST_Settings
msgctxt "ST_Settings,KEY_METAGAME_SETTINGS_NOISEVISIBILITYWIND_DESCRIPTION"
msgid ""
"Show general approximations of how much noise you make, how visible you are "
"and where the wind blows."
msgstr "Zobrazí přibližnou míru hluku, vaši viditelnost a směr větru."

#. Key:	KEY_METAGAME_SETTINGS_NOISEVISIBILITYWIND_NAME
#. SourceLocation:	/Game/BASE/UI/_Shared/ST_Settings.ST_Settings
