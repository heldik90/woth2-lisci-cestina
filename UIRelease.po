#: /Game/BASE/UI/_Shared/ST_Settings.ST_Settings
msgctxt "ST_Settings,KEY_METAGAME_SETTINGS_QUALITYEFFECTS_DESCRIPTION"
msgid ""
"Adjust atmospheric effects, particles, Nanite tesselation, subsurface "
"sampling, and other effects."
msgstr ""
"Nastavte atmosférické efekty, částice, teselaci Nanite, podpovrchové "
"vzorkování a další efekty."

#. Key:	KEY_METAGAME_SETTINGS_QUALITYEFFECTS_NAME
#. SourceLocation:	/Game/BASE/UI/_Shared/ST_Settings.ST_Settings
#. InfoMetaData:	"Notes Localization" : "setting 89 name"
#: /Game/BASE/UI/_Shared/ST_Settings.ST_Settings
