msgstr "Kvalita efektů"

#. Key:	KEY_METAGAME_SETTINGS_QUALITYFOLIAGE_DESCRIPTION
#. SourceLocation:	/Game/BASE/UI/_Shared/ST_Settings.ST_Settings
#. InfoMetaData:	"Notes Localization" : "setting 90 description"
#: /Game/BASE/UI/_Shared/ST_Settings.ST_Settings
msgctxt "ST_Settings,KEY_METAGAME_SETTINGS_QUALITYFOLIAGE_DESCRIPTION"
msgid ""
"Adjust how good foliage looks. The higher it is, the worse the game might "
"perform."
msgstr ""
"Nastavte kvalitu zobrazení vegetace. Vyšší hodnota může snížit výkon hry."

#. Key:	KEY_METAGAME_SETTINGS_QUALITYFOLIAGE_NAME
#. SourceLocation:	/Game/BASE/UI/_Shared/ST_Settings.ST_Settings
#. InfoMetaData:	"Notes Localization" : "setting 90 name"
#: /Game/BASE/UI/_Shared/ST_Settings.ST_Settings
msgctxt "ST_Settings,KEY_METAGAME_SETTINGS_QUALITYFOLIAGE_NAME"
msgid "Foliage quality"
msgstr "Kvalita vegetace"

#. Key:	KEY_METAGAME_SETTINGS_QUALITYPOSTPROCESSING_DESCRIPTION
#. SourceLocation:	/Game/BASE/UI/_Shared/ST_Settings.ST_Settings
#. InfoMetaData:	"Notes Localization" : "setting 91 description"
#: /Game/BASE/UI/_Shared/ST_Settings.ST_Settings
msgctxt "ST_Settings,KEY_METAGAME_SETTINGS_QUALITYPOSTPROCESSING_DESCRIPTION"
msgid ""
"Adjust the effects applied after the base image is produced, such as ambient"
" occlusion, depth of field, lens flares, tone mapping, etc. The higher it "
"is, the worse the game might perform."
msgstr ""
"Upravte efekty přidávané po vykreslení základního obrazu, například okolní "
"okluzi, hloubku ostrosti, odlesky objektivu nebo mapování tónů. Vyšší "
"kvalita může snížit výkon hry."

#. Key:	KEY_METAGAME_SETTINGS_QUALITYPOSTPROCESSING_NAME
#. SourceLocation:	/Game/BASE/UI/_Shared/ST_Settings.ST_Settings
#. InfoMetaData:	"Notes Localization" : "setting 91 name"
#: /Game/BASE/UI/_Shared/ST_Settings.ST_Settings
msgctxt "ST_Settings,KEY_METAGAME_SETTINGS_QUALITYPOSTPROCESSING_NAME"
msgid "Post processing quality"
msgstr "Kvalita následného zpracování"

#. Key:	KEY_METAGAME_SETTINGS_QUALITYSHADOWS_DESCRIPTION
#. SourceLocation:	/Game/BASE/UI/_Shared/ST_Settings.ST_Settings
#. InfoMetaData:	"Notes Localization" : "setting 92 description"
#: /Game/BASE/UI/_Shared/ST_Settings.ST_Settings
msgctxt "ST_Settings,KEY_METAGAME_SETTINGS_QUALITYSHADOWS_DESCRIPTION"
msgid ""
"Adjust how good shadows look. The higher it is, the worse the game might "
"perform."
msgstr ""
"Nastavte kvalitu zobrazení stínů. Vyšší hodnota může snížit výkon hry."

#. Key:	KEY_METAGAME_SETTINGS_QUALITYSHADOWS_NAME
#. SourceLocation:	/Game/BASE/UI/_Shared/ST_Settings.ST_Settings
#. InfoMetaData:	"Notes Localization" : "setting 92 name"
#: /Game/BASE/UI/_Shared/ST_Settings.ST_Settings
msgctxt "ST_Settings,KEY_METAGAME_SETTINGS_QUALITYSHADOWS_NAME"
msgid "Shadows quality"
msgstr "Kvalita stínů"

#. Key:	KEY_METAGAME_SETTINGS_QUALITYTEXTURES_DESCRIPTION
#. SourceLocation:	/Game/BASE/UI/_Shared/ST_Settings.ST_Settings
#. InfoMetaData:	"Notes Localization" : "setting 93 description"
#: /Game/BASE/UI/_Shared/ST_Settings.ST_Settings
msgctxt "ST_Settings,KEY_METAGAME_SETTINGS_QUALITYTEXTURES_DESCRIPTION"
msgid ""
"Adjust how good surfaces look. Higher quality requires more available video "
"memory."
msgstr ""
"Upravte, jak dobře vypadají povrchy. Vyšší kvalita vyžaduje více dostupné "
"videopaměti."

#. Key:	KEY_METAGAME_SETTINGS_QUALITYTEXTURES_NAME
#. SourceLocation:	/Game/BASE/UI/_Shared/ST_Settings.ST_Settings
#. InfoMetaData:	"Notes Localization" : "setting 93 name"
#: /Game/BASE/UI/_Shared/ST_Settings.ST_Settings
msgctxt "ST_Settings,KEY_METAGAME_SETTINGS_QUALITYTEXTURES_NAME"
msgid "Textures quality"
msgstr "Kvalita textur"

#. Key:	KEY_METAGAME_SETTINGS_QUALITYVIEWDISTANCE_DESCRIPTION
#. SourceLocation:	/Game/BASE/UI/_Shared/ST_Settings.ST_Settings
#. InfoMetaData:	"Notes Localization" : "setting 94 description"
#: /Game/BASE/UI/_Shared/ST_Settings.ST_Settings
msgctxt "ST_Settings,KEY_METAGAME_SETTINGS_QUALITYVIEWDISTANCE_DESCRIPTION"
msgid ""
"Adjust how far you can see the game world rendered. The higher it is, the "
"worse the game might perform."
msgstr ""
"Nastavte vzdálenost, do níž se vykresluje herní svět. Vyšší hodnota může "
"snížit výkon hry."

#. Key:	KEY_METAGAME_SETTINGS_QUALITYVIEWDISTANCE_NAME
#. SourceLocation:	/Game/BASE/UI/_Shared/ST_Settings.ST_Settings
#. InfoMetaData:	"Notes Localization" : "setting 94 name"
#: /Game/BASE/UI/_Shared/ST_Settings.ST_Settings
msgctxt "ST_Settings,KEY_METAGAME_SETTINGS_QUALITYVIEWDISTANCE_NAME"
msgid "View distance range"
msgstr "Dohledová vzdálenost"

#. Key:	KEY_METAGAME_SETTINGS_REFLECTIONS_DESCRIPTION
#. SourceLocation:	/Game/BASE/UI/_Shared/ST_Settings.ST_Settings
#. InfoMetaData:	"Notes Localization" : "setting 95 description"
#: /Game/BASE/UI/_Shared/ST_Settings.ST_Settings
msgctxt "ST_Settings,KEY_METAGAME_SETTINGS_REFLECTIONS_DESCRIPTION"
msgid ""
"Adjust how good light reflections look. Lumen high and epic offer the best "
"quality, but they require a capable system, especially the epic option. "
"Screen space reflections are less demanding, but they only take into account"
" what is currently visible, leading to worse quality and potential ghosting."
msgstr ""
"Nastavte kvalitu odrazů světla. Nastavení Lumen – vysoká kvalita a Lumen – "
"epická kvalita nabízejí nejlepší obraz, ale vyžadují výkonný počítač, "
"zejména epické nastavení. Odrazy v prostoru obrazovky jsou méně náročné, ale"
" zohledňují jen právě viditelné objekty. Mohou proto být méně kvalitní a "
"vytvářet duchy v obraze."

#. Key:	KEY_METAGAME_SETTINGS_REFLECTIONS_NAME
#. SourceLocation:	/Game/BASE/UI/_Shared/ST_Settings.ST_Settings
#. InfoMetaData:	"Notes Localization" : "setting 95 name"
#: /Game/BASE/UI/_Shared/ST_Settings.ST_Settings
msgctxt "ST_Settings,KEY_METAGAME_SETTINGS_REFLECTIONS_NAME"
msgid "Reflections"
msgstr "Odrazy"

#. Key:	KEY_METAGAME_SETTINGS_REFLECTIONS_OPTIONS_SCREENSPACE
#. SourceLocation:	/Game/BASE/UI/_Shared/ST_Settings.ST_Settings
#. InfoMetaData:	"Notes Localization" : "reflections option 01"
#: /Game/BASE/UI/_Shared/ST_Settings.ST_Settings
msgctxt "ST_Settings,KEY_METAGAME_SETTINGS_REFLECTIONS_OPTIONS_SCREENSPACE"
msgid "Screen space"
msgstr "Odrazy v prostoru obrazovky"

#. Key:	KEY_METAGAME_SETTINGS_RESOLUTION_DESCRIPTION
#. SourceLocation:	/Game/BASE/UI/_Shared/ST_Settings.ST_Settings
#. InfoMetaData:	"Notes Localization" : "setting 96 description"
#: /Game/BASE/UI/_Shared/ST_Settings.ST_Settings
msgctxt "ST_Settings,KEY_METAGAME_SETTINGS_RESOLUTION_DESCRIPTION"
msgid ""
"Adjust the resolution at which the game is rendered. At higher resolutions, "
"the image will be clearer, but the game might perform worse on less capable "
"systems. Disable this option if you experience low frame rates, but the "
"visuals will be noticeably worse."
msgstr ""
