#. InfoMetaData:	"Is Unique" : "true"
#. InfoMetaData:	"Notes Localization" : "Entry in list of options."
#. InfoMetaData:	"OriginalString" : "Brightness"
#: /Game/BASE/UI/_Shared/ST_UiGeneral.ST_UiGeneral
