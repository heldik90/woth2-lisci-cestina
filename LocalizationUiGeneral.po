#. Key:	KEY_VS_MISSION02_DIALOG_DOG_BODY
#. SourceLocation:	/Game/BASE/UI/_Shared/ST_UiGeneral.ST_UiGeneral
#. InfoMetaData:	"Is Unique" : "true"
#. InfoMetaData:	"Notes Localization" : "Mission text"
#. InfoMetaData:   "OriginalString" : "Holden is now available for you. He'll
#. be sticking close by, ready to follow any commands you give to guide his
#. actions."
#: /Game/BASE/UI/_Shared/ST_UiGeneral.ST_UiGeneral
msgctxt "ST_UiGeneral,KEY_VS_MISSION02_DIALOG_DOG_BODY"
msgid ""
"Holden is now available for you. He'll be sticking close by, ready to follow"
" any commands you give to guide his actions."
msgstr ""
"Holden je nyní pro vás k dispozici. Bude se držet nablízku, připravený plnit"
" jakékoli příkazy, které mu dáte, aby vedl jeho jednání."

#. Key:	KEY_VS_MISSION02_DIALOG_DOG_TITLE
#. SourceLocation:	/Game/BASE/UI/_Shared/ST_UiGeneral.ST_UiGeneral
#. InfoMetaData:	"Is Unique" : "true"
