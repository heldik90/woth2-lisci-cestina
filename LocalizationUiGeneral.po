#. InfoMetaData:	"Is Unique" : "true"
#. InfoMetaData:	"OriginalString" : "Motion blur"
#: /Game/BASE/UI/_Shared/ST_UiGeneral.ST_UiGeneral
msgctxt "ST_UiGeneral,KEY_SAVES_WIZARD_VIDEO_MOTIONBLUR_TITLE"
msgid "Motion blur"
msgstr "Rozmazání pohybu"

