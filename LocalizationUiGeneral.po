msgid "Brightness"
msgstr "Jas"

#. Key:	KEY_SAVES_WIZARD_VIDEO_BRIGHTNESS_TITLE
#. SourceLocation:	/Game/BASE/UI/_Shared/ST_UiGeneral.ST_UiGeneral
