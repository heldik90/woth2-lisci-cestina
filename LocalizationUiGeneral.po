#. Key:	KEY_DIFFICULTY_HARD_DESCRIPTION
#. SourceLocation:	/Game/BASE/UI/_Shared/ST_UiGeneral.ST_UiGeneral
#. InfoMetaData:	"Is Unique" : "true"
#. InfoMetaData:   "OriginalString" : "Embrace the ultimate challenge. In Hard
#. mode, animals are more alert, resources are scarce, and tracking requires
#. sharp observation. Weather is harsher, and survival is as critical as the
#. hunt itself. Precision and strategy are key—only the most skilled hunters
#. will succeed."
#: /Game/BASE/UI/_Shared/ST_UiGeneral.ST_UiGeneral
msgctxt "ST_UiGeneral,KEY_DIFFICULTY_HARD_DESCRIPTION"
msgid ""
"Embrace the ultimate challenge. In Hard mode, animals are more alert, "
"resources are scarce, and tracking requires sharp observation. Weather is "
"harsher, and survival is as critical as the hunt itself. Precision and "
"strategy are key—only the most skilled hunters will succeed."
msgstr ""
"Přijměte nejvyšší výzvu. V tvrdém režimu jsou zvířata ostražitější, zdroje "
"jsou vzácné a sledování vyžaduje ostré pozorování. Počasí je drsnější a "
"přežití je stejně důležité jako samotný lov. Přesnost a strategie jsou "
"klíčové – uspějí pouze ti nejzkušenější lovci."

#. Key:	KEY_DIFFICULTY_HARD_DETAILS
#. SourceLocation:	/Game/BASE/UI/_Shared/ST_UiGeneral.ST_UiGeneral
#. InfoMetaData:	"Is Unique" : "true"
#. InfoMetaData:   "OriginalString" : "- Increased animal awareness\n-
#. Advanced tracking\n- Aggressive predators\n- Minimal HUD assistance"
#: /Game/BASE/UI/_Shared/ST_UiGeneral.ST_UiGeneral
msgctxt "ST_UiGeneral,KEY_DIFFICULTY_HARD_DETAILS"
msgid ""
"- Increased animal awareness\n"
"- Advanced tracking\n"
"- Aggressive predators\n"
"- Minimal HUD assistance"
msgstr ""
"- Zvýšené povědomí o zvířatech\n"
"- Pokročilé sledování\n"
"- Agresivní predátoři\n"
"- Minimální pomoc HUD"

#. Key:	KEY_DIFFICULTY_HARD_NAME
#. SourceLocation:	/Game/BASE/UI/_Shared/ST_UiGeneral.ST_UiGeneral
#. InfoMetaData:	"Is Unique" : "true"
#. InfoMetaData:	"OriginalString" : "Hard"
#: /Game/BASE/UI/_Shared/ST_UiGeneral.ST_UiGeneral
