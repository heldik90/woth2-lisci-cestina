#. InfoMetaData:	"Is Unique" : "true"
#. InfoMetaData:   "OriginalString" : "- Cunning animal behavior\n-
#. Challenging tracking difficulty\n- Aggressive and competitive predators\n-
#. Minimal but crucial HUD assistance"
#: /Game/BASE/UI/_Shared/ST_UiGeneral.ST_UiGeneral
msgctxt "ST_UiGeneral,KEY_DIFFICULTY_RIVAL_DETAILS"
msgid ""
"- Cunning animal behavior\n"
"- Challenging tracking difficulty\n"
"- Aggressive and competitive predators\n"
"- Minimal but crucial HUD assistance"
msgstr ""
"- Chytré chování zvířat\n"
"- Náročná obtížnost sledování\n"
"- Agresivní a soutěživí predátoři\n"
"- Minimální, ale zásadní pomoc HUD"

