msgstr "Odocoileus hemionus"

#. Key:	KEY_ANIMALS_SPECIES_DEERMULE_TRIVIA01
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:   "Notes Localization" : "animal species Mule deer trivia
#. fact 01"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_DEERMULE_TRIVIA01"
msgid "Mule deer lack front teeth; they just have a hard palate."
msgstr ""
"Jelenci ušatí nemají v horní čelisti řezáky; potravu přitlačují k tvrdému "
"patru."

#. Key:	KEY_ANIMALS_SPECIES_DEERMULE_TRIVIA02
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:   "Notes Localization" : "animal species Mule deer trivia
#. fact 02"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_DEERMULE_TRIVIA02"
msgid ""
"Mule deer have a sense of smell that is a thousand times more accurate than "
"a human's sense of smell."
msgstr "Čich jelence ušatého je údajně až tisíckrát citlivější než lidský."

#. Key:	KEY_ANIMALS_SPECIES_DEERMULE_TRIVIA03
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:   "Notes Localization" : "animal species Mule deer trivia
#. fact 03"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_DEERMULE_TRIVIA03"
msgid "Mule deer are able to detect water that is two feet underground."
msgstr "Jelenec ušatý dokáže vycítit vodu přibližně 60 cm pod povrchem."

#. Key:	KEY_ANIMALS_SPECIES_DEERMULE_TRIVIA04
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:   "Notes Localization" : "animal species Mule deer trivia
#. fact 04"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_DEERMULE_TRIVIA04"
msgid ""
"Mule deer are excellent swimmers, but water is rarely used as a means of "
"escaping predators."
msgstr ""
"Jelenec ušatý výborně plave, ale při útěku před predátory vodu využívá jen "
"zřídka."

#. Key:	KEY_ANIMALS_SPECIES_DEERWHITETAILED_APPEARANCE_AGE
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:   "Notes Localization" : "animal species White-tailed deer
#. age variation description"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_DEERWHITETAILED_APPEARANCE_AGE"
msgid "Younger deer may have spotted coats."
msgstr "Mláďata mohou mít skvrnitou srst."

#. Key:	KEY_ANIMALS_SPECIES_DEERWHITETAILED_APPEARANCE_COAT
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:   "Notes Localization" : "animal species White-tailed deer
#. coat description"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_DEERWHITETAILED_APPEARANCE_COAT"
msgid ""
"From lighter reddish brown to darker grayish-brown, depending on the season "
"and environmental conditions"
msgstr ""
"Od světlejší červenohnědé po tmavší šedohnědou, v závislosti na ročním "
"období a podmínkách prostředí"

#. Key:	KEY_ANIMALS_SPECIES_DEERWHITETAILED_APPEARANCE_DIMENSIONS
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:   "Notes Localization" : "animal species White-tailed deer
#. sex dimensions description"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_DEERWHITETAILED_APPEARANCE_DIMENSIONS"
msgid "Bucks are noticeably larger and about a half heavier than does."
msgstr ""
"Samci jsou znatelně větší než samice a váží přibližně o polovinu více."

#. Key:	KEY_ANIMALS_SPECIES_DEERWHITETAILED_APPEARANCE_SEX
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:   "Notes Localization" : "animal species White-tailed deer
#. sex other parameters description"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_DEERWHITETAILED_APPEARANCE_SEX"
msgid "Bucks have antlers. Bucks are also more likely to be solitary."
msgstr "Samci mají parohy a častěji žijí samotářsky."

#. Key:	KEY_ANIMALS_SPECIES_DEERWHITETAILED_DESCRIPTION
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:   "Notes Localization" : "animal species White-tailed deer
#. description"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_DEERWHITETAILED_DESCRIPTION"
msgid ""
"A medium-sized deer characterized by the white underside of its tail used to"
" notify others of a threat. Truly a hunting classic!"
msgstr ""
"Jelenec běloocasý je středně velký jelenovitý. Bílou spodní stranou "
"zdviženého ocasu varuje ostatní před nebezpečím. Patří ke klasické "
"severoamerické lovné zvěři."

#. Key:	KEY_ANIMALS_SPECIES_DEERWHITETAILED_HUNTING_BIOMES
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:   "Notes Localization" : "animal species White-tailed deer
#. biomes description"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_DEERWHITETAILED_HUNTING_BIOMES"
msgid "Forests, grasslands, swamps, arid areas with dense thickets"
msgstr "Lesy, travnaté pláně, bažiny a suché oblasti s hustými houštinami"

#. Key:	KEY_ANIMALS_SPECIES_DEERWHITETAILED_HUNTING_STRENGTHS01
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:   "Notes Localization" : "animal species White-tailed deer
#. strength against hunters 01"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_DEERWHITETAILED_HUNTING_STRENGTHS01"
msgid "Effective camouflage"
msgstr "Dobré maskování v terénu"

#. Key:	KEY_ANIMALS_SPECIES_DEERWHITETAILED_HUNTING_WEAKNESSES01
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:   "Notes Localization" : "animal species White-tailed deer
#. weakness against hunters 01"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_DEERWHITETAILED_HUNTING_WEAKNESSES01"
msgid "Vulnerable to callers and scents during the rut"
msgstr "V říji reaguje na vábničky a pachová lákadla"

#. Key:	KEY_ANIMALS_SPECIES_DEERWHITETAILED_NAME
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:   "Notes Localization" : "animal species White-tailed deer
#. name"
#. InfoMetaData:	"Version" : "DayOnePatch"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_DEERWHITETAILED_NAME"
msgid "White-tailed deer"
msgstr "Jelenec běloocasý"

#. Key:	KEY_ANIMALS_SPECIES_DEERWHITETAILED_NAME_ALTERNATIVE01
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:   "Notes Localization" : "animal species White-tailed deer
#. name, alternative"
#. InfoMetaData:	"Version" : "DayOnePatch"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_DEERWHITETAILED_NAME_ALTERNATIVE01"
msgid "Whitetail"
msgstr "Jelenec běloocasý"

#. Key:	KEY_ANIMALS_SPECIES_DEERWHITETAILED_NAME_LATIN
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:	"MetaData.Gather" : "False"
#. InfoMetaData:   "Notes Localization" : "animal species White-tailed deer
#. name, Latin"
#. InfoMetaData:	"Version" : "DayOnePatch"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_DEERWHITETAILED_NAME_LATIN"
msgid "Odocoileus virginianus"
msgstr "Odocoileus virginianus"

#. Key:	KEY_ANIMALS_SPECIES_DEERWHITETAILED_TRIVIA01
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:   "Notes Localization" : "animal species White-tailed deer
#. trivia fact 01"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_DEERWHITETAILED_TRIVIA01"
msgid ""
"When White-tailed deer gather together and trample down snow in a particular"
" area, this is called a \"deer yard.\""
msgstr ""
"Když se jelenci běloocasí v zimě shromáždí a vyšlapou ve sněhu společný "
"prostor, vznikne jim zimní stanoviště označované anglicky jako deer yard."

#. Key:	KEY_ANIMALS_SPECIES_DEERWHITETAILED_TRIVIA02
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:   "Notes Localization" : "animal species White-tailed deer
#. trivia fact 02"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_DEERWHITETAILED_TRIVIA02"
msgid ""
"White-tailed deer can jump vertically more than 8 ft (2.5 m) and "
"horizontally 30 ft (9 m)."
msgstr ""
"Jelenec běloocasý dokáže vyskočit přes 2,5 metru do výšky a překonat skokem "
"asi 9 metrů do dálky."

#. Key:	KEY_ANIMALS_SPECIES_DEERWHITETAILED_TRIVIA03
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:   "Notes Localization" : "animal species White-tailed deer
#. trivia fact 03"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_DEERWHITETAILED_TRIVIA03"
msgid ""
"White-tailed deer are strong swimmers and can escape from predators across "
"wide streams and lakes."
msgstr ""
"Jelenci běloocasí jsou zdatní plavci a před predátory mohou uniknout přes "
"široké vodní toky i jezera."

#. Key:	KEY_ANIMALS_SPECIES_DEERWHITETAILED_TRIVIA04
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:   "Notes Localization" : "animal species White-tailed deer
#. trivia fact 04"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_DEERWHITETAILED_TRIVIA04"
msgid ""
"White-tailed deer are the shyest and most nervous of deer. When they are "
"startled and run away, their tails wave from side to side."
msgstr ""
"Jelenec běloocasý patří k velmi plachým jelenovitým. Při útěku po vyplašení "
"pohybuje ocasem ze strany na stranu."

#. Key:	KEY_ANIMALS_SPECIES_DEERWHITETAILED_TRIVIA05
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:   "Notes Localization" : "animal species White-tailed deer
#. trivia fact 05"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_DEERWHITETAILED_TRIVIA05"
msgid ""
"White-tailed deer can detect human scent on underbrush for days afterward. "
"Bucks will stay away from areas that have been visited by humans for weeks "
"afterward."
msgstr ""
"Jelenec běloocasý dokáže zachytit lidský pach na vegetaci ještě několik dní "
"po průchodu člověka. Samci se mohou takto navštíveným místům vyhýbat celé "
"týdny."

#. Key:	KEY_ANIMALS_SPECIES_DEERWHITETAILED_TRIVIA06
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:   "Notes Localization" : "animal species White-tailed deer
#. trivia fact 06"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_DEERWHITETAILED_TRIVIA06"
msgid ""
"Whitetail bucks usually lie on their right side when they go to sleep, and "
"they face downwind, enabling them to employ their nose, ears, and eyes to "
"detect danger in any direction."
msgstr ""
"Samci jelence běloocasého často odpočívají na pravém boku čelem po větru. "
"Čichem, sluchem a zrakem tak mohou sledovat své okolí."

#. Key:	KEY_ANIMALS_SPECIES_DUCK_APPEARANCE_AGE
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:   "Notes Localization" : "animal species Duck age variation
#. description\nchanged during localization"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_DUCK_APPEARANCE_AGE"
msgid "They develop more vivid coloring with age."
msgstr "S věkem získávají výraznější zbarvení peří."

#. Key:	KEY_ANIMALS_SPECIES_DUCK_APPEARANCE_COAT
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:	"Notes Localization" : "animal species Duck coat description"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_DUCK_APPEARANCE_COAT"
msgid "A huge variety of color combinations"
msgstr "Pestrá škála barevných kombinací opeření"

#. Key:	KEY_ANIMALS_SPECIES_DUCK_APPEARANCE_DIMENSIONS
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:   "Notes Localization" : "animal species Duck sex dimensions
#. description"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_DUCK_APPEARANCE_DIMENSIONS"
msgid "Drakes are slightly larger and heavier than hens."
msgstr "Kačeři bývají o něco větší a těžší než kachny."

#. Key:	KEY_ANIMALS_SPECIES_DUCK_APPEARANCE_SEX
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:   "Notes Localization" : "animal species Duck sex other
#. parameters description"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_DUCK_APPEARANCE_SEX"
msgid "Drakes are more colorful, while hens are plainer."
msgstr "Kačeři mají pestřejší opeření, kachny jsou zbarvené méně nápadně."

#. Key:	KEY_ANIMALS_SPECIES_DUCK_DESCRIPTION
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:	"Notes Localization" : "animal species Duck description"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_DUCK_DESCRIPTION"
msgid ""
"With their smaller size and shorter necks compared to swans and geese, ducks"
" are one of the most widespread waterfowl groups."
msgstr ""
"Kachny patří k nejrozšířenějším vodním ptákům. Oproti husám a labutím jsou "
"menší a mají kratší krk."

#. Key:	KEY_ANIMALS_SPECIES_DUCK_HUNTING_BIOMES
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:   "Notes Localization" : "animal species Duck biomes
#. description"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_DUCK_HUNTING_BIOMES"
msgid "Wetlands"
msgstr "Mokřady"

#. Key:	KEY_ANIMALS_SPECIES_DUCK_HUNTING_STRENGTHS01
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:   "Notes Localization" : "animal species Duck strength
#. against hunters 01"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_DUCK_HUNTING_STRENGTHS01"
msgid "Fast flight"
msgstr "Rychlý let"

#. Key:	KEY_ANIMALS_SPECIES_DUCK_HUNTING_STRENGTHS02
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:   "Notes Localization" : "animal species Duck strength
#. against hunters 02"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_DUCK_HUNTING_STRENGTHS02"
msgid "Wary"
msgstr "Ostražitost"

#. Key:	KEY_ANIMALS_SPECIES_DUCK_HUNTING_WEAKNESSES01
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:   "Notes Localization" : "animal species Duck weakness
#. against hunters 01"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_DUCK_HUNTING_WEAKNESSES01"
msgid "Predictable behavior when feeding"
msgstr "Při hledání potravy se chová předvídatelně"

#. Key:	KEY_ANIMALS_SPECIES_DUCK_NAME
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:	"Notes Localization" : "animal species Duck name"
#. InfoMetaData:	"Version" : "DayOnePatch"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_DUCK_NAME"
msgid "Duck"
msgstr "Kachna"

#. Key:	KEY_ANIMALS_SPECIES_DUCK_NAME_LATIN
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:	"MetaData.Gather" : "False"
#. InfoMetaData:	"Notes Localization" : "animal species Duck name, Latin"
#. InfoMetaData:	"Version" : "DayOnePatch"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_DUCK_NAME_LATIN"
msgid "Anas"
msgstr "Anas"

#. Key:	KEY_ANIMALS_SPECIES_ELK_APPEARANCE_AGE
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:   "Notes Localization" : "animal species Elk age variation
#. description"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_ELK_APPEARANCE_AGE"
msgid "Adults lose the spots on their skin."
msgstr "U dospělých jedinců mizí skvrny ze srsti."

#. Key:	KEY_ANIMALS_SPECIES_ELK_APPEARANCE_COAT
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:	"Notes Localization" : "animal species Elk coat description"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_ELK_APPEARANCE_COAT"
msgid "Reddish-brown to dark brown or gray"
msgstr "Červenohnědé až tmavě hnědé nebo šedé"

#. Key:	KEY_ANIMALS_SPECIES_ELK_APPEARANCE_DIMENSIONS
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:   "Notes Localization" : "animal species Elk sex dimensions
#. description"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_ELK_APPEARANCE_DIMENSIONS"
msgid "Bulls are larger and significantly heavier than cows."
msgstr "Samci jsou větší a výrazně těžší než samice."

#. Key:	KEY_ANIMALS_SPECIES_ELK_APPEARANCE_SEX
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:   "Notes Localization" : "animal species Elk sex other
#. parameters description"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_ELK_APPEARANCE_SEX"
msgid "Bulls have antlers and are more solitary."
msgstr "Samci mají parohy a častěji žijí samotářsky."

#. Key:	KEY_ANIMALS_SPECIES_ELK_DESCRIPTION
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:	"Notes Localization" : "animal species Elk description"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_ELK_DESCRIPTION"
msgid ""
"Seemingly named to purposefully confuse English speakers on both sides of "
"the Atlantic, these deer are the second largest in their antlers-bearing "
"family. Long believed to be a subspecies of European red deer, they stand "
"their taxonomical ground, with majestic trophies waiting to be harvested."
msgstr ""
"Wapiti je po losovi druhým největším jelenovitým. Dlouho byl považován za "
"poddruh jelena lesního, dnes má samostatné taxonomické postavení. Jeho "
"mohutné paroží je vyhledávanou trofejí."

#. Key:	KEY_ANIMALS_SPECIES_ELK_HUNTING_BIOMES
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:   "Notes Localization" : "animal species Elk biomes
#. description"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_ELK_HUNTING_BIOMES"
msgid "Open woodlands of all elevations and swamps, avoiding dense forests"
msgstr ""
"Řidší lesy v různých nadmořských výškách a bažiny; hustým lesům se vyhýbá"

#. Key:	KEY_ANIMALS_SPECIES_ELK_HUNTING_STRENGTHS01
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:   "Notes Localization" : "animal species Elk strength against
#. hunters 01"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_ELK_HUNTING_STRENGTHS01"
msgid "Able to traverse rugged terrain"
msgstr "Snadno překonává členitý terén"

#. Key:	KEY_ANIMALS_SPECIES_ELK_HUNTING_WEAKNESSES01
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:   "Notes Localization" : "animal species Elk weakness against
#. hunters 01"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_ELK_HUNTING_WEAKNESSES01"
msgid "Reliance on open areas for feeding"
msgstr "Za potravou vychází na otevřená prostranství"

#. Key:	KEY_ANIMALS_SPECIES_ELK_TRIVIA01
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:	"Notes Localization" : "animal species Elk trivia fact 01"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_ELK_TRIVIA01"
msgid "Elk consume an average of 20 lb (9 kg) of vegetation daily."
msgstr "Wapiti denně spase v průměru asi 9 kilogramů rostlin."

#. Key:	KEY_ANIMALS_SPECIES_ELK_TRIVIA02
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:	"Notes Localization" : "animal species Elk trivia fact 02"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_ELK_TRIVIA02"
msgid ""
"As summer approaches, Elk can be seen rubbing against trees in order to get "
"rid of excess hair on their bodies."
msgstr ""
"S blížícím se létem se wapiti otírají o stromy, aby se zbavili přebytečné "
"zimní srsti."

#. Key:	KEY_ANIMALS_SPECIES_ELK_TRIVIA03
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:	"Notes Localization" : "animal species Elk trivia fact 03"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_ELK_TRIVIA03"
msgid ""
"During hotter periods, Elk keep close to bodies of water, lying in, or "
"wading through rivers, lakes, streams and ponds, in order to cool off and "
"escape from biting insects."
msgstr ""
"Za horka se wapiti drží u vody. Lehávají v řekách, jezerech a potocích nebo "
"se jimi brodí, aby se ochladili a unikli bodavému hmyzu."

#. Key:	KEY_ANIMALS_SPECIES_ELK_TRIVIA04
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:	"Notes Localization" : "animal species Elk trivia fact 04"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_ELK_TRIVIA04"
msgid ""
"Elk antlers are made of bone, and sometimes grow at a rate of as much as 1 "
"in (2.5 cm) per day."
msgstr "Parohy wapiti jsou tvořeny kostí a někdy rostou až o 2,5 cm za den."

#. Key:	KEY_ANIMALS_SPECIES_ELK_TRIVIA05
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:	"Notes Localization" : "animal species Elk trivia fact 05"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_ELK_TRIVIA05"
msgid ""
"Elk keep cool by pumping their blood through the veins in their antler "
"velvet. This helps cool the blood before it returns to the heart."
msgstr ""
"Wapiti se ochlazují prouděním krve cévami v lýčí paroží. Krev se tak "
"ochladí, než se vrátí do srdce."

#. Key:	KEY_ANIMALS_SPECIES_ELK_TRIVIA06
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:	"Notes Localization" : "animal species Elk trivia fact 06"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_ELK_TRIVIA06"
msgid ""
"The canine teeth, or ivories, of the Elk are considered by scientists to be "
"rudimentary tusks."
msgstr "Horní špičáky wapitiho, zvané kelce, jsou pozůstatkem dávných klů."

#. Key:	KEY_ANIMALS_SPECIES_HARE_APPEARANCE_AGE
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:   "Notes Localization" : "animal species Hare age variation
#. description"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_HARE_APPEARANCE_AGE"
msgid ""
"While Hares can take care of themselves shortly after birth, they become "
"much more agile as they become adults."
msgstr ""
"Zatímco zajíci se o sebe dokážou postarat krátce po narození, v dospělosti "
"se stávají mnohem obratnějšími."

#. Key:	KEY_ANIMALS_SPECIES_HARE_APPEARANCE_COAT
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:	"Notes Localization" : "animal species Hare coat description"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_HARE_APPEARANCE_COAT"
msgid "Depends on the season"
msgstr "Záleží na ročním období"

#. Key:	KEY_ANIMALS_SPECIES_HARE_APPEARANCE_DIMENSIONS
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:   "Notes Localization" : "animal species Hare sex dimensions
#. description"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_HARE_APPEARANCE_DIMENSIONS"
msgid "Females are usually larger."
msgstr "Samice jsou obvykle větší."

#. Key:	KEY_ANIMALS_SPECIES_HARE_APPEARANCE_SEX
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:   "Notes Localization" : "animal species Hare sex other
#. parameters description"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_HARE_APPEARANCE_SEX"
msgid ""
"No significant differences in male and female hares other than their sizes."
msgstr "Žádné významné rozdíly u samců a samic zajíců kromě jejich velikosti."

#. Key:	KEY_ANIMALS_SPECIES_HARE_DESCRIPTION
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:	"Notes Localization" : "animal species Hare description"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_HARE_DESCRIPTION"
msgid ""
"Surprisingly swift runners over short distances. Compared to Rabbits, Hares "
"are generally solitary and larger, with longer ears."
msgstr ""
"Zajíci dokážou na krátkou vzdálenost běžet překvapivě rychle. Oproti "
"králíkům bývají větší, mají delší uši a většinou žijí samotářsky."

#. Key:	KEY_ANIMALS_SPECIES_HARE_HUNTING_BIOMES
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:   "Notes Localization" : "animal species Hare biomes
#. description"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_HARE_HUNTING_BIOMES"
msgid "Open fields and swamps"
msgstr "Otevřená pole a bažiny"

#. Key:	KEY_ANIMALS_SPECIES_HARE_HUNTING_STRENGTHS01
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:   "Notes Localization" : "animal species Hare strength
#. against hunters 01"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_HARE_HUNTING_STRENGTHS01"
msgid "Agility and speed"
msgstr "Hbitost a rychlost"

#. Key:	KEY_ANIMALS_SPECIES_HARE_HUNTING_STRENGTHS02
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:   "Notes Localization" : "animal species Hare strength
#. against hunters 02"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_HARE_HUNTING_STRENGTHS02"
msgid "Seasonal camouflage"
msgstr "Zbarvení, které se mění podle ročního období"

#. Key:	KEY_ANIMALS_SPECIES_HARE_HUNTING_WEAKNESSES01
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:   "Notes Localization" : "animal species Hare weakness
#. against hunters 01"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_HARE_HUNTING_WEAKNESSES01"
msgid "Limited defense"
msgstr "Málo možností obrany"

#. Key:	KEY_ANIMALS_SPECIES_HARE_NAME
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:	"Notes Localization" : "animal species Hare name"
#. InfoMetaData:	"Version" : "DayOnePatch"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
