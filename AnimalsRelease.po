msgid "Black, white, brown, tan"
msgstr "Černé, bílé, hnědé a světle hnědé opeření"

#. Key:	KEY_ANIMALS_SPECIES_BUSTARD_APPEARANCE_DIMENSIONS
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:   "Notes Localization" : "animal species Bustard sex
#. dimensions description"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_BUSTARD_APPEARANCE_DIMENSIONS"
msgid "Males are larger than females."
msgstr "Samci jsou větší než samice."

#. Key:	KEY_ANIMALS_SPECIES_BUSTARD_APPEARANCE_SEX
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:   "Notes Localization" : "animal species Bustard sex other
#. parameters description"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_BUSTARD_APPEARANCE_SEX"
msgid ""
"Males are more colorful and vocal. They also have more prominent markings."
msgstr ""
"Samci mají pestřejší opeření s výraznější kresbou a hlasitěji se ozývají."

#. Key:	KEY_ANIMALS_SPECIES_BUSTARD_DESCRIPTION
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:	"Notes Localization" : "animal species Bustard description"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_BUSTARD_DESCRIPTION"
msgid ""
"A small landfowl from the grasslands and shrublands of southern Africa."
msgstr ""
"Drobný suchozemský pták z travnatých a křovinatých oblastí jižní Afriky."

#. Key:	KEY_ANIMALS_SPECIES_BUSTARD_HUNTING_BIOMES
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:   "Notes Localization" : "animal species Bustard biomes
#. description"
