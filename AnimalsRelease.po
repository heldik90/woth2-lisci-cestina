msgstr "Los aljašský"

#. Key:	KEY_ANIMALS_SUBSPECIES_ANASPLATYRHYNCHOS_DESCRIPTION
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:   "Notes Localization" : "animal subspecies Mallard
#. description\nchanged during localization"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SUBSPECIES_ANASPLATYRHYNCHOS_DESCRIPTION"
msgid ""
"Mallards are dabbling Ducks that live on all continents except Antarctica. "
"They interbreed on such a scale that scientists have long given up on "
"subcategorizing them. Drakes have distinct green heads."
msgstr ""
"Kachna divoká patří mezi plovavé kachny a žije na všech kontinentech kromě "
"Antarktidy. Její populace se hojně kříží, takže jejich další členění je "
"obtížné. Kačer má nápadně zelenou hlavu."

#. Key:	KEY_ANIMALS_SUBSPECIES_ANASPLATYRHYNCHOS_NAME
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:	"Notes Localization" : "animal subspecies Mallard name"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SUBSPECIES_ANASPLATYRHYNCHOS_NAME"
msgid "Mallard"
msgstr "Kachna divoká"

#. Key:	KEY_ANIMALS_SUBSPECIES_ANASPLATYRHYNCHOS_NAME_ALTERNATIVE01
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:   "Notes Localization" : "animal subspecies Mallard name,
#. alternative 01"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt ""
"ST_Animals,KEY_ANIMALS_SUBSPECIES_ANASPLATYRHYNCHOS_NAME_ALTERNATIVE01"
msgid "Wild duck"
msgstr "Kachna divoká"

