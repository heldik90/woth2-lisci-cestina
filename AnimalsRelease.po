msgid "Navigates remote areas"
msgstr "Pohybuje se i v odlehlých oblastech"

#. Key:	KEY_ANIMALS_SPECIES_BISONAMERICAN_HUNTING_WEAKNESSES01
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:   "Notes Localization" : "animal species American bison
