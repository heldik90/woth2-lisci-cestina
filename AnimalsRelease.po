#. InfoMetaData:	"Notes Localization" : "animal species Boar name"
#. InfoMetaData:	"Version" : "DayOnePatch"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_BOAR_NAME"
msgid "Wild boar"
