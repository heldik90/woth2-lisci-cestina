msgctxt "ST_Animals,KEY_ANIMALS_FAMILIES_LEPORID_NAME"
msgid "Leporids"
msgstr "Zajícovití"

#. Key:	KEY_ANIMALS_FAMILIES_LEPORID_NAME_LATIN
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:	"MetaData.Gather" : "False"
#. InfoMetaData:	"Notes Localization" : "animal family Leporids name in Latin"
#. InfoMetaData:	"Version" : "DayOnePatch"
