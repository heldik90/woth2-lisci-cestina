#. InfoMetaData:	"Notes Localization" : "animal subspecies Spotted hyena name"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SUBSPECIES_CROCUTACROCUTA_NAME"
msgid "Spotted hyena"
msgstr "Hyena skvrnitá"

