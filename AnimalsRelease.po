msgctxt "ST_Animals,KEY_ANIMALS_SUBSPECIES_ANASPLATYRHYNCHOS_NAME_LATIN"
msgid "Anas platyrhynchos platyrhynchos"
msgstr "Anas platyrhynchos platyrhynchos"

#. Key:	KEY_ANIMALS_SUBSPECIES_ANASPLATYRHYNCHOS_NAME_TRIVIA01
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:   "Notes Localization" : "animal subspecies Mallard trivia
#. fact 01"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SUBSPECIES_ANASPLATYRHYNCHOS_NAME_TRIVIA01"
msgid "Mallards are ancestors to all existing domestic duck species."
msgstr "Kachna divoká je předkem domácích kachen."

#. Key:	KEY_ANIMALS_SUBSPECIES_ANASPLATYRHYNCHOS_NAME_TRIVIA02
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:   "Notes Localization" : "animal subspecies Mallard trivia
#. fact 02"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SUBSPECIES_ANASPLATYRHYNCHOS_NAME_TRIVIA02"
msgid "Mallards are the most abundant and widespread waterfowl species."
msgstr "Kachna divoká patří k nejhojnějším a nejrozšířenějším vodním ptákům."

#. Key:	KEY_ANIMALS_SUBSPECIES_ANASUNDULATAUNDULATA_DESCRIPTION
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:   "Notes Localization" : "animal subspecies Southern yellow-
#. billed duck description"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SUBSPECIES_ANASUNDULATAUNDULATA_DESCRIPTION"
msgid ""
"A dabbling Duck from eastern and southern Africa characterized by, well, a "
"yellow bill. Similar in size to mallards. Unlike most ducks, this one is not"
" migratory."
msgstr ""
"Plovavá kachna z východní a jižní Afriky, kterou snadno poznáte podle "
"žlutého zobáku. Velikostí se podobá kachně divoké, na rozdíl od mnoha jiných"
" kachen však netáhne."

