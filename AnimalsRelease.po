msgid "Camouflage in dry grass"
msgstr "Zbarvení ho maskuje v suché trávě"

#. Key:	KEY_ANIMALS_SPECIES_BUSTARD_HUNTING_STRENGTHS02
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:   "Notes Localization" : "animal species Bustard strength
#. against hunters 02"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_BUSTARD_HUNTING_STRENGTHS02"
msgid "Fast takeoff and erratic flight patterns"
msgstr "Rychlý vzlet a nevyzpytatelný let"

#. Key:	KEY_ANIMALS_SPECIES_BUSTARD_HUNTING_WEAKNESSES01
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:   "Notes Localization" : "animal species Bustard weakness
#. against hunters 01"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_BUSTARD_HUNTING_WEAKNESSES01"
msgid "Periodical loud calls"
