msgid "Relatively low speed and agility on land"
msgstr "Na souši je pomalejší a méně obratný"

#. Key:	KEY_ANIMALS_SPECIES_CROCODILE_HUNTING_WEAKNESSES02
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
