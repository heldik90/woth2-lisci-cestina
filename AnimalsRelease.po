#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_RATEL_APPEARANCE_COAT"
msgid "Grayish in the upperparts, black in the underparts"
msgstr "Na hřbetě šedavá srst, na spodní straně těla černá"

#. Key:	KEY_ANIMALS_SPECIES_RATEL_APPEARANCE_DIMENSIONS
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
