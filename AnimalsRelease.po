#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_PRONGHORN_HUNTING_WEAKNESSES01"
msgid "Preference for open habitats"
msgstr "Dává přednost otevřené krajině"

