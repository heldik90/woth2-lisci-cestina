#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_ORDERS_CROCODILIAN_NAME"
msgid "Crocodilians"
msgstr "Krokodýli"

