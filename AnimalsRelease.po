msgstr "Antilocapra americana"

#. Key:	KEY_ANIMALS_SPECIES_PRONGHORN_TRIVIA01
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:   "Notes Localization" : "animal species Pronghorn trivia
#. fact 01"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_PRONGHORN_TRIVIA01"
msgid ""
"The Pronghorn is the fastest land mammal in North America, reaching a top "
"speed of 60 mph (97 km/h)."
msgstr ""
"Vidloroh americký je nejrychlejší suchozemský savec Severní Ameriky. Dokáže "
"dosáhnout rychlosti až 97 km/h (60 mil/h)."

#. Key:	KEY_ANIMALS_SPECIES_PRONGHORN_TRIVIA02
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:   "Notes Localization" : "animal species Pronghorn trivia
#. fact 02"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_PRONGHORN_TRIVIA02"
msgid "Pronghorns are not very good jumpers."
msgstr "Vidlorohové nejsou příliš dobří skokani."

#. Key:	KEY_ANIMALS_SPECIES_PRONGHORN_TRIVIA03
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:   "Notes Localization" : "animal species Pronghorn trivia
#. fact 03"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_PRONGHORN_TRIVIA03"
msgid "Pronghorns can pick up movements from up to 3 mi (4.8 km) away."
msgstr "Vidlorohové zaznamenají pohyb až na vzdálenost 4,8 kilometru."

#. Key:	KEY_ANIMALS_SPECIES_PRONGHORN_TRIVIA04
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:   "Notes Localization" : "animal species Pronghorn trivia
#. fact 04"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_PRONGHORN_TRIVIA04"
msgid "Pronghorns can adjust the angles of the hairs on their skin."
msgstr "Vidlorohové dokážou měnit sklon chlupů v srsti."

#. Key:	KEY_ANIMALS_SPECIES_PRONGHORN_TRIVIA05
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:   "Notes Localization" : "animal species Pronghorn trivia
#. fact 05"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_PRONGHORN_TRIVIA05"
msgid ""
"Pronghorns are able to return food from their stomach back to their mouth "
"and chew it multiple times."
msgstr ""
"Vidlorohové jsou přežvýkavci: potravu vracejí ze žaludku do tlamy a znovu ji"
" rozžvýkají."

#. Key:	KEY_ANIMALS_SPECIES_PRONGHORN_TRIVIA06
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:   "Notes Localization" : "animal species Pronghorn trivia
#. fact 06"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_PRONGHORN_TRIVIA06"
msgid ""
"Though Pronghorns are slower than Cheetahs, they can sustain top speeds for "
"longer."
msgstr ""
"Vidlorohové nedosahují rychlosti geparda, ale vysoké tempo udrží déle."

#. Key:	KEY_ANIMALS_SPECIES_PRONGHORN_TRIVIA07
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:   "Notes Localization" : "animal species Pronghorn trivia
#. fact 07"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_PRONGHORN_TRIVIA07"
msgid ""
"The Pronghorn may have evolved its running ability to escape from now-"
"extinct predators such as the American cheetah."
msgstr ""
"Výjimečná běžecká schopnost vidlorohů se mohla vyvinout jako obrana před "
"dnes vyhynulými predátory, například americkým gepardem."

#. Key:	KEY_ANIMALS_SPECIES_PTARMIGAN_APPEARANCE_AGE
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:   "Notes Localization" : "animal species Ptarmigan age
#. variation description"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_PTARMIGAN_APPEARANCE_AGE"
msgid "Adults develop seasonal plumage."
msgstr "Dospělým jedincům se opeření mění podle ročního období."

#. Key:	KEY_ANIMALS_SPECIES_PTARMIGAN_APPEARANCE_COAT
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:   "Notes Localization" : "animal species Ptarmigan coat
#. description"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_PTARMIGAN_APPEARANCE_COAT"
msgid "White or grayish-brown"
msgstr "Bílá nebo šedohnědá"

#. Key:	KEY_ANIMALS_SPECIES_PTARMIGAN_APPEARANCE_DIMENSIONS
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:   "Notes Localization" : "animal species Ptarmigan sex
#. dimensions description"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_PTARMIGAN_APPEARANCE_DIMENSIONS"
msgid "Males are slightly longer than females."
msgstr "Samci jsou o něco delší než samice."

#. Key:	KEY_ANIMALS_SPECIES_PTARMIGAN_APPEARANCE_SEX
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:   "Notes Localization" : "animal species Ptarmigan sex other
#. parameters description"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_PTARMIGAN_APPEARANCE_SEX"
msgid "Males have reddish eye combs."
msgstr "Samci mají načervenalé nadoční hřebínky."

#. Key:	KEY_ANIMALS_SPECIES_PTARMIGAN_DESCRIPTION
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:	"Notes Localization" : "animal species Ptarmigan description"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_PTARMIGAN_DESCRIPTION"
msgid ""
"Similar to snowshoe hares, this type of grouse bird living in North America,"
" Europe, and Asia has adapted to colder environments with additional "
"\"pads\" on their feet and toes."
msgstr ""
"Bělokur je hrabavý pták ze Severní Ameriky, Evropy a Asie. Chladnému "
"prostředí se přizpůsobil mimo jiné opeřenými prsty, které mu usnadňují pohyb"
" po sněhu."

