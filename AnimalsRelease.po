msgid "Youngsters are more playful and less aggressive."
msgstr "Mláďata jsou hravější a méně agresivní."

#. Key:	KEY_ANIMALS_SPECIES_RATEL_APPEARANCE_COAT
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
