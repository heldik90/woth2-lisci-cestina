#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_BISONAMERICAN_HUNTING_BIOMES"
msgid "Grasslands of lower and higher elevations"
msgstr "Travnaté pláně v nížinách i ve vyšších polohách"

