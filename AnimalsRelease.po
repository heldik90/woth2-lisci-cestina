#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_BUFFALOAFRICAN_APPEARANCE_AGE"
msgid "Adults develop thick horns with a boss, and darker fur."
msgstr "Dospělí jedinci mají mohutné rohy s rohovým štítem a tmavší srst."

#. Key:	KEY_ANIMALS_SPECIES_BUFFALOAFRICAN_APPEARANCE_COAT
