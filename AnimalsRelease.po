msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_WILDEBEEST_TRIVIA01"
msgid "Some Wildebeest have been known to chase predators."
msgstr "Někteří pakoně dokážou predátory sami pronásledovat."

#. Key:	KEY_ANIMALS_SPECIES_WILDEBEEST_TRIVIA02
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:   "Notes Localization" : "animal species Wildebeest trivia
