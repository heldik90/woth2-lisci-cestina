msgid "Aepyceros melampus"
msgstr "Aepyceros melampus"

#. Key:	KEY_ANIMALS_SPECIES_IMPALA_TRIVIA01
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:   "Notes Localization" : "animal species Impala trivia fact
#. 01\nchanged during localization"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_IMPALA_TRIVIA01"
msgid ""
"Female Impalas usually give birth just before noon. At this time, most of "
"the predators are resting."
msgstr ""
"Samice impal obvykle rodí těsně před polednem. V tuto dobu většina predátorů"
" odpočívá."

#. Key:	KEY_ANIMALS_SPECIES_IMPALA_TRIVIA02
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:   "Notes Localization" : "animal species Impala trivia fact
#. 02\nchanged during localization"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_IMPALA_TRIVIA02"
msgid "The word \"Impala\" has Zulu origins. It means \"Gazelle.\""
msgstr "Slovo „impala“ pochází ze zuluštiny a znamená „gazela“."

#. Key:	KEY_ANIMALS_SPECIES_IMPALA_TRIVIA03
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:   "Notes Localization" : "animal species Impala trivia fact
#. 03\nchanged during localization"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_IMPALA_TRIVIA03"
msgid ""
"Impalas are able to jump up to 10 ft (3 m) high and 33 ft (10 m) forward."
msgstr "Impala dokáže vyskočit až tři metry vysoko a deset metrů daleko."

#. Key:	KEY_ANIMALS_SPECIES_IMPALA_TRIVIA04
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:   "Notes Localization" : "animal species Impala trivia fact
#. 04\nchanged during localization"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_IMPALA_TRIVIA04"
msgid ""
"Impalas have an \"M\"-like marking on their rump. This is why they are "
"sometimes called the \"McDonald's of the bush.\""
msgstr ""
"Na zádi impaly je kresba připomínající písmeno M. Proto se jí někdy přezdívá"
" „McDonald’s buše“."

#. Key:	KEY_ANIMALS_SPECIES_KUDU_APPEARANCE_AGE
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:   "Notes Localization" : "animal species Kudu age variation
#. description"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_KUDU_APPEARANCE_AGE"
msgid "Adults are more muscular."
msgstr "Dospělí jsou svalnatější."

#. Key:	KEY_ANIMALS_SPECIES_KUDU_APPEARANCE_COAT
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:	"Notes Localization" : "animal species Kudu coat description"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_KUDU_APPEARANCE_COAT"
msgid ""
"Grayish-brown on bulls to reddish-brown on cows, with white facial markings"
msgstr "Šedohnědá srst u býků a červenohnědá u krav, s bílými znaky na hlavě"

#. Key:	KEY_ANIMALS_SPECIES_KUDU_APPEARANCE_DIMENSIONS
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:   "Notes Localization" : "animal species Kudu sex dimensions
#. description"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_KUDU_APPEARANCE_DIMENSIONS"
msgid "Bulls are larger and heavier than cows."
msgstr "Býci jsou větší a těžší než krávy."

#. Key:	KEY_ANIMALS_SPECIES_KUDU_APPEARANCE_SEX
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:   "Notes Localization" : "animal species Kudu sex other
#. parameters description"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_KUDU_APPEARANCE_SEX"
msgid "Bulls grow horns."
msgstr "Býkům rostou rohy."

#. Key:	KEY_ANIMALS_SPECIES_KUDU_DESCRIPTION
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:	"Notes Localization" : "animal species Kudu description"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_KUDU_DESCRIPTION"
msgid ""
"Spiral-horned antelopes of medium-to-large sizes common to eastern and "
"southern Africa. They prefer woodlands, and despite concerted human efforts "
"to deforest their habitats, they remain elusive and hard to spot there, "
"despite their often impressively long horns."
msgstr ""
"Kudu je středně velká až velká antilopa se spirálovitými rohy, rozšířená ve "
"východní a jižní Africe. Dává přednost lesnatým oblastem. Přestože má často "
"nápadně dlouhé rohy a jeho prostředí ubývá, zůstává obtížné ho zahlédnout."

#. Key:	KEY_ANIMALS_SPECIES_KUDU_HUNTING_BIOMES
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:   "Notes Localization" : "animal species Kudu biomes
#. description"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_KUDU_HUNTING_BIOMES"
msgid "Woodlands and banks of rivers with dense bush and thicket cover"
msgstr "Lesy a říční břehy s hustým křovím a houštinami"

#. Key:	KEY_ANIMALS_SPECIES_KUDU_HUNTING_STRENGTHS01
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:   "Notes Localization" : "animal species Kudu strength
#. against hunters 01"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_KUDU_HUNTING_STRENGTHS01"
msgid "Elusive and shy behavior"
msgstr "Plaché a nenápadné chování"

#. Key:	KEY_ANIMALS_SPECIES_KUDU_HUNTING_STRENGTHS02
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:   "Notes Localization" : "animal species Kudu strength
#. against hunters 02"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_KUDU_HUNTING_STRENGTHS02"
msgid "Ability to blend into dense vegetation"
msgstr "V husté vegetaci snadno splývá s okolím"

#. Key:	KEY_ANIMALS_SPECIES_KUDU_HUNTING_WEAKNESSES01
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:   "Notes Localization" : "animal species Kudu weakness
#. against hunters 01"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_KUDU_HUNTING_WEAKNESSES01"
msgid "Dependent on water"
msgstr "Závislá na vodě"

#. Key:	KEY_ANIMALS_SPECIES_KUDU_HUNTING_WEAKNESSES02
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:   "Notes Localization" : "animal species Kudu weakness
#. against hunters 02"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_KUDU_HUNTING_WEAKNESSES02"
msgid "Poor endurance"
msgstr "Slabá výdrž"

#. Key:	KEY_ANIMALS_SPECIES_KUDU_NAME
