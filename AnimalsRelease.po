msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_ZEBRA_APPEARANCE_AGE"
msgid "Adults exhibit a more assertive behavior."
msgstr "Dospělí jedinci se ve stádě prosazují výrazněji."

#. Key:	KEY_ANIMALS_SPECIES_ZEBRA_APPEARANCE_COAT
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
