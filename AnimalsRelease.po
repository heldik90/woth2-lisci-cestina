msgid "African buffalo"
msgstr "Buvol africký"

#. Key:	KEY_ANIMALS_SPECIES_BUFFALOAFRICAN_NAME_LATIN
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
