msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_CROCODILE_HUNTING_STRENGTHS01"
msgid "Powerful jaws"
msgstr "Silné čelisti"

#. Key:	KEY_ANIMALS_SPECIES_CROCODILE_HUNTING_STRENGTHS02
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
