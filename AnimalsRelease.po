#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_WOLVERINE_HUNTING_WEAKNESSES01"
msgid "Predictable scavenging"
msgstr "Předvídatelně vyhledává mršiny"

