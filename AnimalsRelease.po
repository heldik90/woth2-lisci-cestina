msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_BUFFALOAFRICAN_HUNTING_STRENGTHS02"
msgid "Strong herd instincts"
msgstr "Silný stádní pud"

#. Key:	KEY_ANIMALS_SPECIES_BUFFALOAFRICAN_HUNTING_STRENGTHS03
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:   "Notes Localization" : "animal species African buffalo
#. strength against hunters 03"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_BUFFALOAFRICAN_HUNTING_STRENGTHS03"
msgid "Unpredictable"
msgstr "Nepředvídatelné chování"

#. Key:	KEY_ANIMALS_SPECIES_BUFFALOAFRICAN_HUNTING_WEAKNESSES01
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
#. InfoMetaData:   "Notes Localization" : "animal species African buffalo
#. weakness against hunters 01"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
