#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_PRONGHORN_HUNTING_STRENGTHS01"
msgid "High alertness"
msgstr "Vysoká ostražitost"

#. Key:	KEY_ANIMALS_SPECIES_PRONGHORN_HUNTING_WEAKNESSES01
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
