msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_WILDEBEEST_TRIVIA02"
msgid ""
"Wildebeest are quite noisy animals, constantly emitting a low moaning sound."
msgstr "Pakoně jsou hlučná zvířata a často vydávají hluboké mručivé zvuky."

#. Key:	KEY_ANIMALS_SPECIES_WOLFGRAY_APPEARANCE_AGE
