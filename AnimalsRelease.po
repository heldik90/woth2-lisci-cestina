msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_BISONAMERICAN_HUNTING_WEAKNESSES01"
msgid "Predictable grazing and drinking"
msgstr "Pravidelně se pase a chodí pít"

#. Key:	KEY_ANIMALS_SPECIES_BISONAMERICAN_HUNTING_WEAKNESSES02
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
