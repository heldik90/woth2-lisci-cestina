msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_BISONAMERICAN_HUNTING_STRENGTHS01"
msgid "Massive size, with the ability to charge"
msgstr "Mohutné tělo a schopnost prudce zaútočit"

#. Key:	KEY_ANIMALS_SPECIES_BISONAMERICAN_HUNTING_STRENGTHS02
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
