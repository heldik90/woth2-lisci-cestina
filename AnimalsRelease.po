#: /Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
msgctxt "ST_Animals,KEY_ANIMALS_SPECIES_CROCODILE_HUNTING_STRENGTHS02"
msgid "Stealthy ambush hunting"
msgstr "Nenápadný lov ze zálohy"

#. Key:	KEY_ANIMALS_SPECIES_CROCODILE_HUNTING_WEAKNESSES01
#. SourceLocation:	/Game/BASE/Animals/_Shared/ST_Animals.ST_Animals
