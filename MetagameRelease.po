#: /Game/BASE/Characters/_Shared/ST_NPCs.ST_NPCs
msgctxt "ST_NPCs,KEY_NPCMAP02_02_NAME"
msgid "Damian Underwood"
msgstr "Damian Underwood"

#. Key:	KEY_NPCMAP02_02_OCCUPATION
