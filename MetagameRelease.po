#. Key:	KEY_TUTORIAL01_MISSION02_VO07_1_L02_AITRAINER
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "changed during localization"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION02_VO07_1_L02_AITRAINER"
msgid ""
"Although you can hear the Moose and its sound cues, at this range it can "
"neither hear nor see you."
msgstr "Losa už slyšíte, ale z této vzdálenosti vás ještě nevidí ani neslyší."

#. Key:	KEY_TUTORIAL01_MISSION02_VO07_1_L03_AITRAINER
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "changed during localization"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION02_VO07_1_L03_AITRAINER"
msgid "Be aware that a gunshot will scare animals from a long distance."
msgstr "Výstřel vyplaší zvěř i na velkou vzdálenost."

#. Key:	KEY_TUTORIAL01_MISSION02_VO07_L01_AITRAINER
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"MetaData.Gather" : "False"
#. InfoMetaData:	"Notes Localization" : "Tutorial 2 for beginners part36"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION02_VO07_L01_AITRAINER"
msgid "KEY_TUTORIAL01_MISSION02_OBJECTIVE05_VO12_L01_AITRAINER"
msgstr "Když úlovek prodáte, nebudete ho moci později nechat preparovat."

#. Key:	KEY_TUTORIAL01_MISSION02_VO08_1_L01_1_AITRAINER
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "changed during localization"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION02_VO08_1_L01_1_AITRAINER"
msgid "You’ve entered the detection range: 150 meters or less."
msgstr ""
"Přiblížili jste se na 150 metrů nebo méně. Zvěř vás už může zpozorovat."

