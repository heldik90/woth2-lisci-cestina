#: /Game/BASE/UI/_Shared/ST_GameFlow.ST_GameFlow
msgctxt "ST_GameFlow,KEY_SHOOTING_RANGE_POP_UP_HEADLINE"
msgid "Welcome to the Hearth & Hunt shooting range!"
msgstr "Vítejte na střelnici Hearth & Hunt!"

