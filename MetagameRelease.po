msgid "Migoi Passe"
msgstr "Migoi Passe"

#. Key:	KEY_ENVIRONMENT_MAP03_LANDPUBLIC03_NAME
#. SourceLocation:	/Game/BASE/Maps/_Shared/ST_Levels.ST_Levels
#: /Game/BASE/Maps/_Shared/ST_Levels.ST_Levels
msgctxt "ST_Level,KEY_ENVIRONMENT_MAP03_LANDPUBLIC03_NAME"
msgid "Xueren Basin"
msgstr "Xueren Basin"

#. Key:	KEY_ENVIRONMENT_MAP03_LANDPUBLIC04_NAME
#. SourceLocation:	/Game/BASE/Maps/_Shared/ST_Levels.ST_Levels
#: /Game/BASE/Maps/_Shared/ST_Levels.ST_Levels
msgctxt "ST_Level,KEY_ENVIRONMENT_MAP03_LANDPUBLIC04_NAME"
msgid "Miche Forest Sea"
msgstr "Miche Forest Sea"

#. Key:	KEY_ENVIRONMENT_MAP03_NAME
#. SourceLocation:	/Game/BASE/Maps/_Shared/ST_Levels.ST_Levels
#: /Game/BASE/Maps/_Shared/ST_Levels.ST_Levels
msgctxt "ST_Level,KEY_ENVIRONMENT_MAP03_NAME"
msgid "Parvata Raj"
msgstr "Parvata Raj"

#. Key:	KEY_ENVIRONMENT_MAPHUB_DESCRIPTION01
#. SourceLocation:	/Game/BASE/Maps/_Shared/ST_Levels.ST_Levels
#. InfoMetaData:	"Notes Localization" : "maphub reserve cutscene text, part01"
#: /Game/BASE/Maps/_Shared/ST_Levels.ST_Levels
msgctxt "ST_Level,KEY_ENVIRONMENT_MAPHUB_DESCRIPTION01"
msgid "The Hearth & Hunt Headquarters welcome you!"
msgstr "Vítá vás Hearth & Hunt Headquarters!"

#. Key:	KEY_ENVIRONMENT_MAPHUB_DESCRIPTION02
#. SourceLocation:	/Game/BASE/Maps/_Shared/ST_Levels.ST_Levels
#. InfoMetaData:	"Notes Localization" : "maphub reserve cutscene text, part02"
#: /Game/BASE/Maps/_Shared/ST_Levels.ST_Levels
msgctxt "ST_Level,KEY_ENVIRONMENT_MAPHUB_DESCRIPTION02"
msgid ""
"This central hub right by the Rocky Mountains range is your getaway "
"destination after intense hunts around the world."
msgstr ""
"Tato základna přímo u Skalistých hor vám nabízí útočiště po náročných "
"loveckých výpravách po celém světě."

#. Key:	KEY_ENVIRONMENT_MAPHUB_DESCRIPTION03
#. SourceLocation:	/Game/BASE/Maps/_Shared/ST_Levels.ST_Levels
#. InfoMetaData:	"Notes Localization" : "maphub reserve cutscene text, part03"
#: /Game/BASE/Maps/_Shared/ST_Levels.ST_Levels
msgctxt "ST_Level,KEY_ENVIRONMENT_MAPHUB_DESCRIPTION03"
msgid ""
"Enjoy the picturesque tranquility of the nature around you and feel free to "
"hunt while you're here."
msgstr ""
"Užijte si malebný klid přírody kolem vás a neváhejte lovit, když jste tady."

#. Key:	KEY_ENVIRONMENT_MAPHUB_DESCRIPTION04
#. SourceLocation:	/Game/BASE/Maps/_Shared/ST_Levels.ST_Levels
#. InfoMetaData:	"Notes Localization" : "maphub reserve cutscene text, part04"
#: /Game/BASE/Maps/_Shared/ST_Levels.ST_Levels
msgctxt "ST_Level,KEY_ENVIRONMENT_MAPHUB_DESCRIPTION04"
msgid ""
"At the Lodge, display the best Trophies you've collected around the world, "
"and why not expand it once you've run out of space."
msgstr ""
"V lovecké chatě vystavte nejlepší trofeje ze svých cest. Až vám dojde místo,"
" můžete chatu rozšířit."

#. Key:	KEY_ENVIRONMENT_MAPHUB_DESCRIPTION05
#. SourceLocation:	/Game/BASE/Maps/_Shared/ST_Levels.ST_Levels
#. InfoMetaData:	"Notes Localization" : "maphub reserve cutscene text, part05"
#: /Game/BASE/Maps/_Shared/ST_Levels.ST_Levels
msgctxt "ST_Level,KEY_ENVIRONMENT_MAPHUB_DESCRIPTION05"
msgid ""
"There's no map of the surrounding area, so you'll have to explore it and "
"find out how you can develop it further by yourself."
msgstr ""
"Mapu okolí nemáte, a tak musíte oblast sami prozkoumat a zjistit, jak ji "
"můžete dále rozvíjet."

#. Key:	KEY_ENVIRONMENT_MAPHUB_LANDPRIVATE01_NAME
#. SourceLocation:	/Game/BASE/Maps/_Shared/ST_Levels.ST_Levels
#: /Game/BASE/Maps/_Shared/ST_Levels.ST_Levels
msgctxt "ST_Level,KEY_ENVIRONMENT_MAPHUB_LANDPRIVATE01_NAME"
msgid "Hearth & Hunt Estate"
msgstr "Hearth & Hunt Estate"

#. Key:	KEY_ENVIRONMENT_MAPHUB_NAME
#. SourceLocation:	/Game/BASE/Maps/_Shared/ST_Levels.ST_Levels
#: /Game/BASE/Maps/_Shared/ST_Levels.ST_Levels
msgctxt "ST_Level,KEY_ENVIRONMENT_MAPHUB_NAME"
msgid "Hearth & Hunt Headquarters"
msgstr "Hearth & Hunt Headquarters"

#. Key:	KEY_TUTORIAL01_MISSION01_HELPER_BINOCULARS_AIM
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial for beginners helper01"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION01_HELPER_BINOCULARS_AIM"
msgid "Aim at the mule deer."
msgstr "Zamiřte na jelence ušatého."

#. Key:	KEY_TUTORIAL01_MISSION01_HELPER_BINOCULARS_HIDE
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:   "Notes Localization" : "Tutorial for beginners helper02,
#. changed during localization"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION01_HELPER_BINOCULARS_HIDE"
msgid "Press <input>{IA_ADS}|displayAs(Input)</> to hide binoculars."
msgstr "Stisknutím <input>{IA_ADS}|displayAs(Input)</> schováte dalekohled."

#. Key:	KEY_TUTORIAL01_MISSION01_HELPER_BINOCULARS_SELECT
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "changed during localization"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION01_HELPER_BINOCULARS_SELECT"
msgid ""
"Press <input>{IA_SelectGear}|displayAs(Input, actionName = "
"inventory_Slot4)</> to select binoculars."
msgstr ""
"Stisknutím <input>{IA_SelectGear}|displayAs(Input, actionName = "
"inventory_Slot4)</> vyberte dalekohled."

#. Key:	KEY_TUTORIAL01_MISSION01_HELPER_BINOCULARS_USE
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:   "Notes Localization" : "Tutorial for beginners helper04,
#. changed during localization"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION01_HELPER_BINOCULARS_USE"
msgid "Press <input>{IA_ADS}|displayAs(Input)</> to use binoculars."
msgstr ""
"Chcete-li použít dalekohled, stiskněte <input>{IA_ADS}|displayAs(Input)</>."

#. Key:	KEY_TUTORIAL01_MISSION01_HELPER_CROUCH
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:   "Notes Localization" : "Tutorial for beginners helper05,
#. changed during localization"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION01_HELPER_CROUCH"
msgid ""
"Press <input>{IA_Crouch}|displayAs(Input)</> to switch to the crouch stance."
msgstr ""
"Stisknutím <input>{IA_Crouch}|displayAs(Input)</> přepnete do skrčeného "
"postoje."

#. Key:	KEY_TUTORIAL01_MISSION01_HELPER_CROUCH_STAND
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:   "Notes Localization" : "Tutorial for beginners helper06,
#. changed during localization"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION01_HELPER_CROUCH_STAND"
msgid ""
"Press <input>{IA_Crouch}|displayAs(Input)</> to stand up from the crouch "
"stance."
msgstr ""
"Stisknutím <input>{IA_Crouch}|displayAs(Input)</> se z podřepu narovnáte."

#. Key:	KEY_TUTORIAL01_MISSION01_HELPER_HOLD_BREATH
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:   "Notes Localization" : "Tutorial for beginners helper07,
#. changed during localization"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION01_HELPER_HOLD_BREATH"
msgid ""
"Hold <input>{IA_HoldBreath}|displayAs(Input)</> while aiming to hold your "
"breath and steady your aim."
msgstr ""
"Při míření podržte <input>{IA_HoldBreath}|displayAs(Input)</>. Zadržíte dech"
" a ustálíte zbraň."

#. Key:	KEY_TUTORIAL01_MISSION01_HELPER_INTERACT
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:   "Notes Localization" : "Tutorial for beginners helper08,
#. changed during localization"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION01_HELPER_INTERACT"
msgid ""
"When close to a ladder, press "
"<input>{IA_InteractTapPrimary}|displayAs(Input)</> to climb it."
msgstr ""
"Když jste blízko žebříku, stiskněte "
"<input>{IA_InteractTapPrimary}|displayAs(Input)</> a vyšplhejte na něj."

#. Key:	KEY_TUTORIAL01_MISSION01_HELPER_JUMP
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:   "Notes Localization" : "Tutorial for beginners helper09,
#. changed during localization"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION01_HELPER_JUMP"
msgid "Press <input>{IA_Jump}|displayAs(Input)</> to jump over obstacles."
msgstr ""
"Chcete-li přeskakovat překážky, stiskněte "
"<input>{IA_Jump}|displayAs(Input)</>."

#. Key:	KEY_TUTORIAL01_MISSION01_HELPER_MARK_ANIMAL
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial for beginners helper10"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION01_HELPER_MARK_ANIMAL"
msgid ""
"Focus the center of the view on the mule deer briefly to analyze it and see "
"its info."
msgstr ""
"Zaměřte na chvíli střed zorného pole na jelence ušatého, abyste si zobrazili"
" údaje o něm."

#. Key:	KEY_TUTORIAL01_MISSION01_HELPER_MARKER
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:   "Notes Localization" : "Tutorial for beginners helper11,
#. changed during localization"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION01_HELPER_MARKER "
msgid "Press <input>{IA_PlaceMarker}|displayAs(Input)</> to place a marker."
msgstr ""
"Stisknutím <input>{IA_PlaceMarker}|displayAs(Input)</> umístíte značku."

#. Key:	KEY_TUTORIAL01_MISSION01_HELPER_PRIMARY_RIFLE_AIM
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:   "Notes Localization" : "Tutorial for beginners helper12,
#. changed during localization"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION01_HELPER_PRIMARY_RIFLE_AIM"
msgid "Press <input>{IA_ADS}|displayAs(Input)</> to aim."
msgstr "Stisknutím <input>{IA_ADS}|displayAs(Input)</> zamiřte."

#. Key:	KEY_TUTORIAL01_MISSION01_HELPER_PRIMARY_RIFLE_SELECT
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "changed during localization"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION01_HELPER_PRIMARY_RIFLE_SELECT"
msgid ""
"Press <input>{IA_SelectGear}|displayAs(Input, actionName = "
"inventory_Slot1)</> to select your primary rifle."
msgstr ""
"Stisknutím <input>{IA_SelectGear}|displayAs(Input, actionName = "
"inventory_Slot1)</> vyberte svou primární pušku."

#. Key:	KEY_TUTORIAL01_MISSION01_HELPER_PRIMARY_RIFLE_SHOOT
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:   "Notes Localization" : "Tutorial for beginners helper14,
#. changed during localization"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION01_HELPER_PRIMARY_RIFLE_SHOOT"
msgid "Shoot by pressing <input>{IA_Fire}|displayAs(Input)</> while aiming."
msgstr ""
"Při míření vystřelíte stisknutím <input>{IA_Fire}|displayAs(Input)</>."

#. Key:	KEY_TUTORIAL01_MISSION01_HELPER_PRIMARY_RIFLE_ZOOM
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:   "Notes Localization" : "Tutorial for beginners helper15,
#. changed during localization"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION01_HELPER_PRIMARY_RIFLE_ZOOM"
msgid ""
"Use "
"<input>{IA_ZoomIncrease}|displayAs(Input)</>/<input>{IA_ZoomDecrease}|displayAs(Input)</>"
" to zoom in and zoom out."
msgstr ""
"Použijte "
"<input>{IA_ZoomIncrease}|displayAs(Input)</>/<input>{IA_ZoomDecrease}|displayAs(Input)</>"
" pro přiblížení a oddálení."

#. Key:	KEY_TUTORIAL01_MISSION01_HELPER_PRONE
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:   "Notes Localization" : "Tutorial for beginners helper16,
#. changed during localization"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION01_HELPER_PRONE"
msgid ""
"Hold <input>{IA_Prone}|displayAs(Input)</> to switch to the prone stance."
msgstr "Podržením <input>{IA_Prone}|displayAs(Input)</> si lehnete."

#. Key:	KEY_TUTORIAL01_MISSION01_HELPER_PRONE_STAND
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:   "Notes Localization" : "Tutorial for beginners helper17,
#. changed during localization"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION01_HELPER_PRONE_STAND"
msgid ""
"Hold <input>{IA_Prone}|displayAs(Input)</> to stand up from the prone "
"stance."
msgstr "Podržením <input>{IA_Prone}|displayAs(Input)</> vstanete z lehu."

#. Key:	KEY_TUTORIAL01_MISSION01_HELPER_RELOAD
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "changed during localization"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION01_HELPER_RELOAD"
msgid "Press <input>{IA_Reload}|displayAs(Input)</> to reload."
msgstr "Stisknutím <input>{IA_Reload}|displayAs(Input)</> přebijete zbraň."

#. Key:	KEY_TUTORIAL01_MISSION01_HELPER_RUN
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:   "Notes Localization" : "Tutorial for beginners helper18,
#. changed during localization"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION01_HELPER_RUN"
msgid "Press <input>{IA_Run}|displayAs(Input)</> to run."
msgstr "Stisknutím <input>{IA_Run}|displayAs(Input)</> se rozběhnete."

#. Key:	KEY_TUTORIAL01_MISSION01_HELPER_SKIP
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "changed during localization"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION01_HELPER_SKIP"
msgid ""
"Welcome to the training grounds! Here you'll learn how to control your "
"character and the basics of hunting. Feel free to skip the tutorial at any "
"point (open the sidebar Game Menu and select \"Skip the tutorial\"). You can"
" always get back to it later!"
msgstr ""
"Vítejte na cvičišti! Naučíte se tu ovládat postavu a poznáte základy lovu. "
"Výcvik můžete kdykoli přeskočit: otevřete postranní herní nabídku a zvolte "
"„Přeskočit výcvik“. Později se k němu můžete vrátit."

#. Key:	KEY_TUTORIAL01_MISSION01_HELPER_WALK
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "changed during localization"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION01_HELPER_WALK"
msgid "Use <input>{IA_Move}|displayAs(input, actionName = All)</> to walk."
msgstr ""
"Pomocí <input>{IA_Move}|displayAs(input, actionName = All)</> se pohybujete."

#. Key:	KEY_TUTORIAL01_MISSION01_LABEL_CONTINUE
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "changed during localization"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION01_LABEL_CONTINUE"
msgid "Continue"
msgstr "Pokračovat"

#. Key:	KEY_TUTORIAL01_MISSION01_LABEL_SKIP
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "changed during localization"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION01_LABEL_SKIP"
msgid "Skip"
msgstr "Přeskočit"

#. Key:	KEY_TUTORIAL01_MISSION01_LABEL_TUTORIAL
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "changed during localization"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION01_LABEL_TUTORIAL"
msgid "Tutorial"
msgstr "Výcvik"

#. Key:	KEY_TUTORIAL01_MISSION01_NAME
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial for beginners name"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION01_NAME"
msgid "Chapter 1: the basics of hunting"
msgstr "Kapitola 1: základy lovu"

#. Key:	KEY_TUTORIAL01_MISSION01_OBJECTIVE01_NAME
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial for beginners part01"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION01_OBJECTIVE01_NAME"
msgid "Get to the high ground."
msgstr "Dostaňte se na vyvýšené místo."

#. Key:	KEY_TUTORIAL01_MISSION01_OBJECTIVE01_VO011_1_L01_AITRAINER
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial for beginners part06"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt ""
"ST_Tutorial,KEY_TUTORIAL01_MISSION01_OBJECTIVE01_VO011_1_L01_AITRAINER"
msgid ""
"Objective markers, like the one on the top of the hill, will always help you"
" complete your objectives. Now, follow the path to the marker."
msgstr ""
"Značky úkolů, například ta na vrcholu kopce, vám ukazují cestu. Nyní jděte "
"po stezce ke značce."

#. Key:	KEY_TUTORIAL01_MISSION01_OBJECTIVE01_VO012_2_L01_01_AITRAINER
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial for beginners part07"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt ""
"ST_Tutorial,KEY_TUTORIAL01_MISSION01_OBJECTIVE01_VO012_2_L01_01_AITRAINER"
msgid ""
"Binoculars give you advantage over animals, as you can see them before they "
"see you. Now try to get closer. One hundred meters or less."
msgstr ""
"Díky dalekohledu můžete zvěř zahlédnout dřív, než ona uvidí vás. Teď se "
"přibližte na 100 metrů nebo méně."

#. Key:	KEY_TUTORIAL01_MISSION01_OBJECTIVE01_VO012_2_L01_AITRAINER
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial for beginners part08"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt ""
"ST_Tutorial,KEY_TUTORIAL01_MISSION01_OBJECTIVE01_VO012_2_L01_AITRAINER"
msgid ""
"Binoculars give you an advantage over animals, as you can see them before "
"they see you. Now try to get closer. One hundred ten yards or less."
msgstr ""
"Díky dalekohledu můžete zvěř zahlédnout dřív, než ona uvidí vás. Teď se "
"přibližte na 110 yardů nebo méně."

#. Key:	KEY_TUTORIAL01_MISSION01_OBJECTIVE01_VO01_L01_AITRAINER
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial for beginners part02"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION01_OBJECTIVE01_VO01_L01_AITRAINER"
msgid "Welcome to the Hearth & Hunt testing grounds!"
msgstr "Vítejte na cvičišti Hearth & Hunt!"

#. Key:	KEY_TUTORIAL01_MISSION01_OBJECTIVE01_VO01_L02_AITRAINER
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial for beginners part03"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION01_OBJECTIVE01_VO01_L02_AITRAINER"
msgid ""
"Once you finish this stage, you'll unlock more demanding tests. If you "
"complete them all you'll receive a once-in-a-lifetime reward."
msgstr ""
"Po dokončení této části se vám otevřou náročnější zkoušky. Splňte je všechny"
" a získáte jedinečnou odměnu."

#. Key:	KEY_TUTORIAL01_MISSION01_OBJECTIVE01_VO01_L03_AITRAINER
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial for beginners part04"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION01_OBJECTIVE01_VO01_L03_AITRAINER"
msgid "We're delighted that you chose us as your future employer."
msgstr ""
"Jsme rádi, že jste si nás vybrali jako svého budoucího zaměstnavatele."

#. Key:	KEY_TUTORIAL01_MISSION01_OBJECTIVE01_VO01_L04_AITRAINER
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "changed during localization"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION01_OBJECTIVE01_VO01_L04_AITRAINER"
msgid ""
"We'll provide you with basic training, and we'll evaluate your skills. Now, "
"let's start with basic movement."
msgstr ""
"Poskytneme vám základní školení a zhodnotíme vaše dovednosti. Nyní začněme "
"základním pohybem."

#. Key:	KEY_TUTORIAL01_MISSION01_OBJECTIVE01_VO02_L01_AITRAINER
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "changed during localization"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION01_OBJECTIVE01_VO02_L01_AITRAINER"
msgid ""
"Take a look around. The wilderness will be your constant companion once you "
"join Hearth & Hunt."
msgstr ""
"Rozhlédněte se kolem sebe. Jakmile se připojíte k Hearth & Hunt, divočina "
"bude vaším stálým společníkem."

#. Key:	KEY_TUTORIAL01_MISSION01_OBJECTIVE01_VO02_L02_AITRAINER
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial for beginners part10"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION01_OBJECTIVE01_VO02_L02_AITRAINER"
msgid ""
"Analyze the mule deer in front of you using binoculars. You'll learn vital "
"information about the animal."
msgstr ""
"Prohlédněte si dalekohledem jelence ušatého před sebou. Zjistíte o něm "
"důležité údaje."

#. Key:	KEY_TUTORIAL01_MISSION01_OBJECTIVE02_NAME
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "changed during localization"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION01_OBJECTIVE02_NAME"
msgid "Spot and analyze the animal using binoculars."
msgstr "Najděte zvěř dalekohledem a prozkoumejte ji."

#. Key:	KEY_TUTORIAL01_MISSION01_OBJECTIVE02_VO03_L01_AITRAINER
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial for beginners part12"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION01_OBJECTIVE02_VO03_L01_AITRAINER"
msgid "There's your mule deer."
msgstr "Tamhle je jelenec ušatý."

#. Key:	KEY_TUTORIAL01_MISSION01_OBJECTIVE02_VO03_L02_AITRAINER
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial for beginners part13"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION01_OBJECTIVE02_VO03_L02_AITRAINER"
msgid ""
"But it's a bit far away. Try to get closer. Two hundred meters or less."
msgstr ""
"Ale je to trochu daleko. Zkuste se přiblížit. Dvě stě metrů nebo méně."

#. Key:	KEY_TUTORIAL01_MISSION01_OBJECTIVE03_1_NAME
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial for beginners part14"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION01_OBJECTIVE03_1_NAME"
msgid "Enter the hunting stand."
msgstr "Vystoupejte na posed."

#. Key:	KEY_TUTORIAL01_MISSION01_OBJECTIVE03_2_NAME
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial for beginners part15"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION01_OBJECTIVE03_2_NAME"
msgid "Mark the location of the Mule deer."
msgstr "Označte polohu jelence ušatého."

#. Key:	KEY_TUTORIAL01_MISSION01_OBJECTIVE03_NAME
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial for beginners part16"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION01_OBJECTIVE03_NAME"
msgid "Get closer to the Mule deer."
msgstr "Přibližte se k jelenci ušatému."

#. Key:	KEY_TUTORIAL01_MISSION01_OBJECTIVE04_NAME
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial for beginners part17"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION01_OBJECTIVE04_NAME"
msgid "Shoot the Mule deer. Aim for its heart or lungs."
msgstr "Ulovte jelence ušatého. Miřte na komoru, tedy na srdce nebo plíce."

#. Key:	KEY_TUTORIAL01_MISSION01_OBJECTIVE04_VO04_L01_AITRAINER
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial for beginners part18"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION01_OBJECTIVE04_VO04_L01_AITRAINER"
msgid "Now that wasn’t a mule deer, was it?"
msgstr "To ale nebyl jelenec ušatý, že?"

#. Key:	KEY_TUTORIAL01_MISSION01_OBJECTIVE04_VO04_L02_AITRAINER
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial for beginners part19"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION01_OBJECTIVE04_VO04_L02_AITRAINER"
msgid "Let’s try again."
msgstr "Zkusme to znovu."

#. Key:	KEY_TUTORIAL01_MISSION01_OBJECTIVE04_VO05_L01_AITRAINER
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial for beginners part20"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION01_OBJECTIVE04_VO05_L01_AITRAINER"
msgid ""
"That will do the trick, but you shouldn't be aiming for the head. It's both "
"inefficient and cruel."
msgstr ""
"Takový zásah sice zvěř usmrtí, ale na hlavu nemiřte. Je to neefektivní a "
"kruté."

#. Key:	KEY_TUTORIAL01_MISSION01_OBJECTIVE04_VO05_L02_AITRAINER
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial for beginners part21"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION01_OBJECTIVE04_VO05_L02_AITRAINER"
msgid "Let’s try again."
msgstr "Zkusme to znovu."

#. Key:	KEY_TUTORIAL01_MISSION01_OBJECTIVE04_VO06_L01_AITRAINER
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial for beginners part22"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION01_OBJECTIVE04_VO06_L01_AITRAINER"
msgid "Those weren't the vitals."
msgstr "Nezasáhli jste životně důležité orgány."

#. Key:	KEY_TUTORIAL01_MISSION01_OBJECTIVE04_VO06_L02_AITRAINER
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial for beginners part23"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION01_OBJECTIVE04_VO06_L02_AITRAINER"
msgid "Let’s try again."
msgstr "Zkusme to znovu."

#. Key:	KEY_TUTORIAL01_MISSION01_OBJECTIVE04_VO07_L01_AITRAINER
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial for beginners part24"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION01_OBJECTIVE04_VO07_L01_AITRAINER"
msgid "Well done."
msgstr "Dobrá práce."

#. Key:	KEY_TUTORIAL01_MISSION01_OBJECTIVE04_VO13_L01_AITRAINER
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial for beginners part25"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION01_OBJECTIVE04_VO13_L01_AITRAINER"
msgid "It's easy to lose track of your surroundings in the wilderness."
msgstr "V divočině je snadné ztratit přehled o svém okolí."

#. Key:	KEY_TUTORIAL01_MISSION01_OBJECTIVE04_VO13_L02_AITRAINER
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial for beginners part26"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION01_OBJECTIVE04_VO13_L02_AITRAINER"
msgid ""
"Always mark the location you're trying to reach. In this case, mark a spot "
"near the animal before shooting."
msgstr ""
"Vždy označte místo, kam se snažíte dostat. V tomto případě si před střelbou "
"označte místo v blízkosti zvířete."

#. Key:	KEY_TUTORIAL01_MISSION01_OBJECTIVE04_VO13_L03_AITRAINER
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial for beginners part27"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION01_OBJECTIVE04_VO13_L03_AITRAINER"
msgid ""
"This will help you find the hit blood, so you can easily pick up the trail "
"from there."
msgstr "To vám pomůže najít barvu na nástřelu a odtud se vydat po stopě."

#. Key:	KEY_TUTORIAL01_MISSION01_OBJECTIVE05_NAME
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "changed during localization"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION01_OBJECTIVE05_NAME"
msgid ""
"Go to the marked spot, locate the hit blood there and interact with it."
msgstr ""
"Dojděte na označené místo, najděte barvu na nástřelu a prozkoumejte ji."

#. Key:	KEY_TUTORIAL01_MISSION01_OBJECTIVE05_VO08_L01_AITRAINER
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial for beginners part29"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION01_OBJECTIVE05_VO08_L01_AITRAINER"
msgid "Follow the blood trail to find your mule deer."
msgstr "Sledujte stopu barvy a najděte jelence ušatého."

#. Key:	KEY_TUTORIAL01_MISSION01_OBJECTIVE05_VO14_L01_AITRAINER
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial for beginners part30"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION01_OBJECTIVE05_VO14_L01_AITRAINER"
msgid ""
"You've found hit blood. It provides important clues about the potential "
"harvest."
msgstr ""
"Našli jste barvu na nástřelu. Poskytuje důležité informace o zasaženém kusu."

#. Key:	KEY_TUTORIAL01_MISSION01_OBJECTIVE05_VO14_L02_AITRAINER
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial for beginners part31"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION01_OBJECTIVE05_VO14_L02_AITRAINER"
msgid ""
"If you hit the vitals correctly, the blood spatter will be large, pink, and "
"full of oxygen bubbles, indicating the harvest is very close."
msgstr ""
"Po zásahu srdce nebo plic bývá na nástřelu hodně světle růžové, zpěněné "
"barvy. To značí, že raněný kus nejspíš nedoběhne daleko."

#. Key:	KEY_TUTORIAL01_MISSION01_OBJECTIVE05_VO14_L03_AITRAINER
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial for beginners part32"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION01_OBJECTIVE05_VO14_L03_AITRAINER"
msgid ""
"Now, follow the blood trail, and also keep in mind that the splatters not "
"only reveal the details about the shot, but also indicate the direction to "
"pursue."
msgstr ""
"Teď se vydejte po stopě barvy. Kapky prozradí nejen podrobnosti o zásahu, "
"ale i směr, kterým zvěř odběhla."

#. Key:	KEY_TUTORIAL01_MISSION01_OBJECTIVE06_1_NAME
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:   "Notes Localization" : "Tutorial for beginners
#. part33\nchanged during localization"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION01_OBJECTIVE06_1_NAME"
msgid "Follow the blood trail to locate the harvest."
msgstr "Sledujte stopu barvy a najděte úlovek."

#. Key:	KEY_TUTORIAL01_MISSION01_OBJECTIVE06_2_NAME
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial for beginners part34"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION01_OBJECTIVE06_2_NAME"
msgid "Analyze the White-tailed deer using binoculars."
msgstr "Prohlédněte si jelence běloocasého dalekohledem."

#. Key:	KEY_TUTORIAL01_MISSION01_OBJECTIVE06_3_NAME
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial for beginners part35"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION01_OBJECTIVE06_3_NAME"
msgid "Mark the location of the White-tailed deer."
msgstr "Označte polohu jelence běloocasého."

#. Key:	KEY_TUTORIAL01_MISSION01_OBJECTIVE06_4_NAME
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial for beginners part36"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION01_OBJECTIVE06_4_NAME"
msgid "Follow the blood trail to locate the White-tailed deer."
msgstr "Sledujte stopu barvy a najděte jelence běloocasého."

#. Key:	KEY_TUTORIAL01_MISSION01_OBJECTIVE06_NAME
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial for beginners part37"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION01_OBJECTIVE06_NAME"
msgid "Follow the blood track and get to the Mule deer."
msgstr "Sledujte stopu barvy k jelenci ušatému."

#. Key:	KEY_TUTORIAL01_MISSION01_OBJECTIVE06_VO09_L01_AITRAINER
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "changed during localization"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION01_OBJECTIVE06_VO09_L01_AITRAINER"
msgid "Well done. We'll get to harvesting later."
msgstr "Dobrá práce. Zpracování úlovku si ukážeme později."

#. Key:	KEY_TUTORIAL01_MISSION01_OBJECTIVE06_VO09_L02_AITRAINER
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial for beginners part39"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION01_OBJECTIVE06_VO09_L02_AITRAINER"
msgid "Now let’s try that again."
msgstr "Nyní to zkusme znovu."

#. Key:	KEY_TUTORIAL01_MISSION01_OBJECTIVE07_NAME
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial for beginners part40"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION01_OBJECTIVE07_NAME"
msgid "Use binoculars to spot and mark a White-tailed deer."
msgstr "Najděte dalekohledem jelence běloocasého a označte ho."

#. Key:	KEY_TUTORIAL01_MISSION01_OBJECTIVE07_VO15_L01_AITRAINER
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial for beginners part41"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION01_OBJECTIVE07_VO15_L01_AITRAINER"
msgid "Let's repeat what we've learned."
msgstr "Zopakujme si, co jsme se naučili."

#. Key:	KEY_TUTORIAL01_MISSION01_OBJECTIVE07_VO15_L02_AITRAINER
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial for beginners part42"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION01_OBJECTIVE07_VO15_L02_AITRAINER"
msgid "Always remember to first analyze the animal to confirm the species."
msgstr "Než vystřelíte, vždy si zvěř prohlédněte, abyste určili její druh."

#. Key:	KEY_TUTORIAL01_MISSION01_OBJECTIVE07_VO15_L03_AITRAINER
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial for beginners part43"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION01_OBJECTIVE07_VO15_L03_AITRAINER"
msgid ""
"Mark the place where you'll be looking for the hit blood. Also, hold your "
"breath to be steady and deliver a precise shot."
msgstr ""
"Označte si místo, kde pak budete hledat barvu na nástřelu. Při míření "
"zadržte dech, aby se zbraň ustálila a rána byla přesná."

#. Key:	KEY_TUTORIAL01_MISSION01_OBJECTIVE07_VO15_L04_AITRAINER
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial for beginners part44"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION01_OBJECTIVE07_VO15_L04_AITRAINER"
msgid ""
"Aim for the vitals to get a fast and humane kill. The color of the blood "
"will give you a good idea whether you hit or missed."
msgstr ""
"Miřte na komoru, tedy na oblast srdce a plic. Takový zásah vede k rychlému a"
" šetrnému ulovení. Barva na nástřelu vám napoví, zda jste zasáhli správně."

#. Key:	KEY_TUTORIAL01_MISSION01_OBJECTIVE07_VO15_L05_AITRAINER
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial for beginners part45"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION01_OBJECTIVE07_VO15_L05_AITRAINER"
msgid ""
"Follow the blood trail, and eventually you'll find the harvest. Happy "
"hunting!"
msgstr "Sledujte stopu barvy, až najdete úlovek. Lovu zdar!"

#. Key:	KEY_TUTORIAL01_MISSION01_OBJECTIVE08_NAME
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial for beginners part46"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION01_OBJECTIVE08_NAME"
msgid "Shoot the White-tailed deer to its vitals."
msgstr "Zasáhněte jelence běloocasého na komoru."

#. Key:	KEY_TUTORIAL01_MISSION01_OBJECTIVE08_VO10_L01_AITRAINER
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial for beginners part47"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION01_OBJECTIVE08_VO10_L01_AITRAINER"
msgid ""
"I'd have thought you'd know where the vitals are by now, but it seems you "
"don't!"
msgstr "Myslel jsem, že už víte, kde má zvěř komoru, ale zřejmě ne!"

#. Key:	KEY_TUTORIAL01_MISSION01_OBJECTIVE08_VO10_L02_AITRAINER
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial for beginners part48"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION01_OBJECTIVE08_VO10_L02_AITRAINER"
msgid "Let’s try that again."
msgstr "Zkusme to znovu."

#. Key:	KEY_TUTORIAL01_MISSION01_OBJECTIVE09_NAME
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial for beginners part49"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION01_OBJECTIVE09_NAME"
msgid "Locate the shot White-tailed deer."
msgstr "Najděte postřeleného jelence běloocasého."

#. Key:	KEY_TUTORIAL01_MISSION01_OBJECTIVE09_VO11_L01_AITRAINER
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial for beginners part50"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION01_OBJECTIVE09_VO11_L01_AITRAINER"
msgid "Well done! The first part of your training is over. Let’s continue."
msgstr "Výborně! První část vašeho tréninku je u konce. Pokračujme."

#. Key:	KEY_TUTORIAL01_MISSION01_OBJECTIVE09_VO12_L01_AITRAINER
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial for beginners part51"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION01_OBJECTIVE09_VO12_L01_AITRAINER"
msgid "Well done! It seems like we chose a good applicant."
msgstr "Výborně! Zdá se, že jsme vybrali dobrého uchazeče."

#. Key:	KEY_TUTORIAL01_MISSION01_OBJECTIVE09_VO12_L02_AITRAINER
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial for beginners part52"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION01_OBJECTIVE09_VO12_L02_AITRAINER"
msgid "Your first assignment is in New Laurentia."
msgstr "Váš první úkol je v New Laurentia."

#. Key:	KEY_TUTORIAL01_MISSION01_OBJECTIVE09_VO13_L01_AITRAINER
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:   "Notes Localization" : "Tutorial for beginners
#. part53\nchanged during localization"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION01_OBJECTIVE09_VO13_L01_AITRAINER"
msgid "Chapter 1 of the training session is now complete!"
msgstr "Kapitola 1 školení je nyní dokončena!"

#. Key:	KEY_TUTORIAL01_MISSION01_POP_UP_BLOOD_HEADLINE
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial for beginners part54"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION01_POP_UP_BLOOD_HEADLINE"
msgid "Blood color and its meaning"
msgstr "Barva krve a její význam"

#. Key:	KEY_TUTORIAL01_MISSION01_POP_UP_BLOOD_TYPE
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial for beginners part55"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION01_POP_UP_BLOOD_TYPE"
msgid ""
"The hit blood color differs depending on the damaged organ. If you shot a "
"vital organ like the heart or lungs, the color will appear pinkish, with "
"foam or bubbles. When the liver is hit, the color is dark crimson, when the "
"stomach and intestines are hit, it's red with food particles. And if it was "
"just a scratch, you'll see a small amount of red blood."
msgstr ""
"Barva na nástřelu napoví, který orgán střela zasáhla. Při zásahu srdce či "
"plic bývá světle růžová a zpěněná. Po zásahu jater je tmavě červená; po "
"zásahu žaludku nebo střev může obsahovat zbytky potravy. Při povrchovém "
"poranění najdete jen malé množství červené barvy."

#. Key:	KEY_TUTORIAL01_MISSION01_POP_UP_PREBETA
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial for beginners part56"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION01_POP_UP_PREBETA"
msgid ""
"— How to equip a firearm - Shotgun (Inventory, Backpack)\n"
"— How to move stealthily and detect animal Tracks (Noise indicator, player visibility, wind detection)\n"
"— How the Claim screen works\n"
"— How to spawn your Dog companion and use commands\n"
"— How the Hunting map and fast travel work"
msgstr ""
"— Jak si vzít brokovnici a další výbavu z inventáře či batohu\n"
"— Jak se tiše pohybovat a hledat pobytové znaky zvěře (hluk, viditelnost a směr větru)\n"
"— Jak číst přehled úlovku\n"
"— Jak přivolat psa a dávat mu povely\n"
"— Jak používat loveckou mapu a rychlý přesun"

#. Key:	KEY_TUTORIAL01_MISSION01_POP_UP_PREBETA_HEADLINE
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial for beginners part57"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION01_POP_UP_PREBETA_HEADLINE"
msgid "What will you learn in the next Beginner tutorials?"
msgstr "Co se naučíte v dalších částech výcviku?"

#. Key:	KEY_TUTORIAL01_MISSION01_POP_UP_PREBETA_TAKEME
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial for beginners part58"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION01_POP_UP_PREBETA_TAKEME"
msgid "Take me to New Laurentia"
msgstr "Vezmi mě do New Laurentia"

#. Key:	KEY_TUTORIAL01_MISSION01_POP_UP_VITALS_AID
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:   "Notes Localization" : "Tutorial for beginners
#. part59\nPlaceholder text"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION01_POP_UP_VITALS_AID"
msgid ""
"With Hunter assist enabled, you can see where your bullet will end up.  "
"Always aim for the vitals for the most effective and ethical harvest."
msgstr ""
"Se zapnutou loveckou asistencí vidíte, kam střela dopadne. Pro účinné a "
"etické ulovení miřte na komoru."

#. Key:	KEY_TUTORIAL01_MISSION01_POP_UP_VITALS_HEADLINE
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial for beginners part72"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION01_POP_UP_VITALS_HEADLINE"
msgid "Animal vitals and shot placement"
msgstr "Životně důležité orgány a umístění zásahu"

#. Key:	KEY_TUTORIAL01_MISSION02_HELPER_DOG_HOME
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "changed during localization"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION02_HELPER_DOG_HOME"
msgid ""
"Press <input>{IA_ActionMenu}|displayAs(Input)</> to open the radial menu and"
" then press <input>{IA_UiActionMenu_next}|displayAs(Input)</> to switch to "
"Dog commands and select the command \"Home.\""
msgstr ""
"Stisknutím <input>{IA_ActionMenu}|displayAs(Input)</> otevřete kruhovou "
"nabídku. Poté stisknutím <input>{IA_UiActionMenu_next}|displayAs(Input)</> "
"přepněte na psí povely a vyberte „Domů“."

#. Key:	KEY_TUTORIAL01_MISSION02_HELPER_HUNTINGMAP
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "changed during localization"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION02_HELPER_HUNTINGMAP"
msgid ""
"Press <input>{IA_HuntingMap}|displayAs(Input)</> to open the hunting map. "
"You’ll see the objective area where you need to look for Tracks."
msgstr ""
"Stisknutím <input>{IA_HuntingMap}|displayAs(Input)</> otevřete loveckou "
"mapu. Je na ní vyznačená oblast, kde máte hledat stopy."

#. Key:	KEY_TUTORIAL01_MISSION02_HELPER_NEW_RIFLE
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "changed during localization"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION02_HELPER_NEW_RIFLE"
msgid ""
"Press <input>{IA_SelectGear}|displayAs(Input, actionName = "
"inventory_Slot1)</> to select the newly acquired rifle."
msgstr ""
"Stiskněte <input>{IA_SelectGear}|displayAs(Input, actionName = "
"inventory_Slot1)</> pro výběr nově získané pušky."

#. Key:	KEY_TUTORIAL01_MISSION02_HELPER_PRIMARY
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "changed during localization"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION02_HELPER_PRIMARY"
msgid ""
"Press <input>{IA_SelectGear1}|displayAs(Input)</> to select the primary "
"firearm."
msgstr ""
"Stisknutím <input>{IA_SelectGear1}|displayAs(Input)</> vyberte primární "
"střelnou zbraň."

#. Key:	KEY_TUTORIAL01_MISSION02_HELPER_SECONDARY
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "changed during localization"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION02_HELPER_SECONDARY"
msgid ""
"Press <input>{IA_SelectGear2}|displayAs(Input)</> to select the secondary "
"firearm."
msgstr ""
"Stisknutím <input>{IA_SelectGear2}|displayAs(Input)</> vyberte sekundární "
"střelnou zbraň."

#. Key:	KEY_TUTORIAL01_MISSION02_HELPER_SLOW_WALK
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "changed during localization"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION02_HELPER_SLOW_WALK"
msgid "Press <input>{IA_Walk}|displayAs(Input)</> to walk slowly."
msgstr "Stisknutím <input>{IA_Walk}|displayAs(Input)</> můžete chodit pomalu."

#. Key:	KEY_TUTORIAL01_MISSION02_HELPER_ZEROING
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "changed during localization"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION02_HELPER_ZEROING"
msgid ""
"Press repeteadly <input>{IA_RangeDecrease}|displayAs(Input)</> to zero your "
"rifle for 100 m."
msgstr ""
"Opakovaným stisknutím <input>{IA_RangeDecrease}|displayAs(Input)</> nastavte"
" nástřelnou vzdálenost pušky na 100 m."

#. Key:	KEY_TUTORIAL01_MISSION02_HELPER_ZEROING_1
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "changed during localization"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION02_HELPER_ZEROING_1"
msgid ""
"Press repeteadly <input>{IA_RangeDecrease}|displayAs(Input)</> to zero your "
"rifle for 110 yd."
msgstr ""
"Opakovaným stisknutím <input>{IA_RangeDecrease}|displayAs(Input)</> nastavte"
" nástřelnou vzdálenost pušky na 110 yd."

#. Key:	KEY_TUTORIAL01_MISSION02_NAME
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "changed during localization"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION02_NAME"
msgid "Chapter 3: practice makes perfect"
msgstr "Kapitola 3: Cvičení dělá mistra"

#. Key:	KEY_TUTORIAL01_MISSION02_OBJECTIVE01_NAME
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial 2 for beginners part02"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION02_OBJECTIVE01_NAME"
msgid "Open the storage and equip the shotgun."
msgstr "Otevřete sklad a vybavte se brokovnicí."

#. Key:	KEY_TUTORIAL01_MISSION02_OBJECTIVE01_VO01_L01_AITRAINER
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial 2 for beginners part03"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION02_OBJECTIVE01_VO01_L01_AITRAINER"
msgid "You’ve bagged your first big game. Let’s switch gears to landfowls."
msgstr ""
"První kus velké zvěře máte za sebou. Teď se zaměříme na hrabavou zvěř."

#. Key:	KEY_TUTORIAL01_MISSION02_OBJECTIVE02_NAME
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "changed during localization"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION02_OBJECTIVE02_NAME"
msgid ""
"Find a Feeding spot of a Wild turkey inside the objective area highlighted "
"on your Hunting map."
msgstr ""
"V oblasti vyznačené na lovecké mapě najděte místo, kde se živí krocan "
"divoký."

#. Key:	KEY_TUTORIAL01_MISSION02_OBJECTIVE02_VO02_L01_AITRAINER
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial 2 for beginners part06"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION02_OBJECTIVE02_VO02_L01_AITRAINER"
msgid ""
"With every movement you make, you produce noise, which alerts the animals."
msgstr ""
"Každým pohybem vydáváte hluk, který může zvěř upozornit na vaši přítomnost."

#. Key:	KEY_TUTORIAL01_MISSION02_OBJECTIVE02_VO03_L01_AITRAINER
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial 2 for beginners part07"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION02_OBJECTIVE02_VO03_L01_AITRAINER"
msgid "Animals can see you as well. Be mindful of how well you're covered."
msgstr "Zvěř vás může i zahlédnout. Dbejte na to, abyste byli dobře krytí."

#. Key:	KEY_TUTORIAL01_MISSION02_OBJECTIVE02_VO04_L01_AITRAINER
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial 2 for beginners part08"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION02_OBJECTIVE02_VO04_L01_AITRAINER"
msgid ""
"And, of course, animals have a keen sense of smell. Be aware of the wind "
"direction, as it can expose your scent and location."
msgstr ""
"Zvěř má také výborný čich. Hlídejte si směr větru: váš pach může prozradit, "
"kde jste."

#. Key:	KEY_TUTORIAL01_MISSION02_OBJECTIVE03_NAME
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial 2 for beginners part09"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION02_OBJECTIVE03_NAME"
msgid "Analyze the Wild turkey using binoculars."
msgstr "Prohlédněte si krocana divokého dalekohledem."

#. Key:	KEY_TUTORIAL01_MISSION02_OBJECTIVE04_NAME
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:   "Notes Localization" : "Tutorial 2 for beginners
#. part10\nchanged during localization"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION02_OBJECTIVE04_NAME"
msgid ""
"Get within {maxShotDistance}|displayAs(distance) of the Wild turkey without "
"spooking it. Lower your stance, go slowly and use bushes for cover."
msgstr ""
"Přibližte se ke krocanovi divokému na vzdálenost "
"{maxShotDistance}|displayAs(distance), aniž ho vyplašíte. Skrčte se, "
"postupujte pomalu a kryjte se za keři."

#. Key:	KEY_TUTORIAL01_MISSION02_OBJECTIVE04_VO05_L01_AITRAINER
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial 2 for beginners part11"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION02_OBJECTIVE04_VO05_L01_AITRAINER"
msgid ""
"To approach turkeys stealthily, crouch low and move slowly, using cover if "
"possible."
msgstr ""
"Ke krocanům se přibližujte pomalu a přikrčeně. Pokud můžete, využívejte "
"kryt."

#. Key:	KEY_TUTORIAL01_MISSION02_OBJECTIVE04_VO06_L01_AITRAINER
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial 2 for beginners part12"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION02_OBJECTIVE04_VO06_L01_AITRAINER"
msgid "Be careful! Running inevitably spooks animals around you."
msgstr "Pozor! Pokud poběžíte, vyplašíte zvěř v okolí."

#. Key:	KEY_TUTORIAL01_MISSION02_OBJECTIVE04_VO07_L01_AITRAINER
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial 2 for beginners part13"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION02_OBJECTIVE04_VO07_L01_AITRAINER"
msgid ""
"Right now, you're moving in exactly the same direction as the wind, so "
"animals can detect your scent."
msgstr ""
"Právě teď se pohybujete přesně stejným směrem jako vítr, takže zvířata mohou"
" rozpoznat váš pach."

#. Key:	KEY_TUTORIAL01_MISSION02_OBJECTIVE05_1_NAME
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "changed during localization"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION02_OBJECTIVE05_1_NAME"
msgid "Get to the range where the Moose can detect you."
msgstr "Přibližte se natolik, aby vás los mohl zpozorovat."

#. Key:	KEY_TUTORIAL01_MISSION02_OBJECTIVE05_NAME
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "changed during localization"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION02_OBJECTIVE05_NAME"
msgid ""
"Shoot from {40}|displayAs(distance) or less and harvest the Wild turkey. Aim"
" at the head while it's on the ground."
msgstr ""
"Střelte krocana divokého ze vzdálenosti nejvýše {40}|displayAs(distance) a "
"zpracujte úlovek. Pokud je na zemi, miřte na hlavu."

#. Key:	KEY_TUTORIAL01_MISSION02_OBJECTIVE05_VO08_L01_AITRAINER
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial 2 for beginners part15"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION02_OBJECTIVE05_VO08_L01_AITRAINER"
msgid ""
"Turkeys are supposed to be shot in the air, but... be my guest, I guess."
msgstr "Krocani se mají lovit v letu, ale… dobře, jak chcete."

#. Key:	KEY_TUTORIAL01_MISSION02_OBJECTIVE05_VO09_L01_AITRAINER
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial 2 for beginners part16"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION02_OBJECTIVE05_VO09_L01_AITRAINER"
msgid ""
"This is the screen where you can see information about your harvest and the "
"Trophy you've earned. You can also study your shot placements."
msgstr ""
"Na této obrazovce najdete údaje o úlovku a jeho trofeji. Můžete si také "
"prohlédnout, kam vaše střely zasáhly."

#. Key:	KEY_TUTORIAL01_MISSION02_OBJECTIVE05_VO10_L01_AITRAINER
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial 2 for beginners part16"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION02_OBJECTIVE05_VO10_L01_AITRAINER"
msgid ""
"The bullet camera lets you follow the trajectory of the bullets that hit the"
" animal's body. You can switch views depending on the shot."
msgstr ""
"Kamera zásahu umožňuje sledovat dráhu střel, které zasáhly zvíře. Můžete "
"přepínat mezi pohledy na jednotlivé zásahy."

#. Key:	KEY_TUTORIAL01_MISSION02_OBJECTIVE05_VO11_L01_AITRAINER
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial 2 for beginners part18"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION02_OBJECTIVE05_VO11_L01_AITRAINER"
msgid "In this section, you can see the animal Trophy and its score."
msgstr "V této části si můžete prohlédnout trofej a její bodové hodnocení."

#. Key:	KEY_TUTORIAL01_MISSION02_OBJECTIVE05_VO12_L01_AITRAINER
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial 2 for beginners part19"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION02_OBJECTIVE05_VO12_L01_AITRAINER"
msgid ""
"If you choose to sell your harvest, you won’t be able to taxidermy it later."
msgstr "Když úlovek prodáte, nebudete ho moci později nechat preparovat."

#. Key:	KEY_TUTORIAL01_MISSION02_OBJECTIVE05_VO13_L01_AITRAINER
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial 2 for beginners part20"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION02_OBJECTIVE05_VO13_L01_AITRAINER"
msgid ""
"If you choose to taxidermy, you can mount it later on one of the diorama "
"stands at your Lodge."
msgstr ""
"Pokud si zvolíte preparaci, můžete zvíře později vystavit v jednom z "
"diorámat ve své lovecké chatě."

#. Key:	KEY_TUTORIAL01_MISSION02_OBJECTIVE06_1_NAME
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "changed during localization"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION02_OBJECTIVE06_1_NAME"
msgid "Stalk the Moose until you get to the shooting distance."
msgstr "Podcházejte losa, dokud se nedostanete na dostřel."

#. Key:	KEY_TUTORIAL01_MISSION02_POP_UP_ANIMAL_TIERS
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:   "Notes Localization" : "Tutorial 2 for beginners
#. part04\nPlaceholder text"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION02_POP_UP_ANIMAL_TIERS"
msgid ""
"Explanation of animal and weapon Tiers. Match each Tier with the animal."
msgstr "Úrovně zvěře a zbraní: pro každý druh zvolte odpovídající úroveň."

#. Key:	KEY_TUTORIAL01_MISSION02_POP_UP_DOGCOMMANDS_1_DESCRIPTION
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial 3 for beginners part26"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt ""
"ST_Tutorial,KEY_TUTORIAL01_MISSION02_POP_UP_DOGCOMMANDS_1_DESCRIPTION"
msgid ""
"To control your dog, open the radial menu and select \"Recall.\" Now you will be able to give all other commands.\n"
"\n"
"You can also command your dog to follow a blood trail. To do this, interact with a specific source of blood in the world, then command the dog to \"Track blood.\""
msgstr ""
"Chcete-li psovi dávat povely, otevřete kruhovou nabídku a zvolte „Přivolat zpět“. Poté můžete vybrat další povely.\n"
"\n"
"Pes také může sledovat stopu barvy. Prozkoumejte konkrétní stopu barvy v terénu a pak mu dejte povel „Sleduj barvu“."

#. Key:	KEY_TUTORIAL01_MISSION02_POP_UP_DOGCOMMANDS_DESCRIPTION
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial 3 for beginners part25"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION02_POP_UP_DOGCOMMANDS_DESCRIPTION"
msgid ""
"This is a radial menu containing available commands for the dog. When you "
"select Search, the dog will look for the nearest animal tracks in the area."
msgstr ""
"V této kruhové nabídce najdete psí povely. Po volbě „Hledej“ bude pes v "
"okolí pátrat po nejbližších stopách zvěře."

#. Key:	KEY_TUTORIAL01_MISSION02_POP_UP_DOGCOMMANDS_HEADLINE
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial 3 for beginners part27"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION02_POP_UP_DOGCOMMANDS_HEADLINE"
msgid "Dog commands"
msgstr "Psí povely"

#. Key:	KEY_TUTORIAL01_MISSION02_POP_UP_STEALTH_DESCRIPTION
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial 3 for beginners part22"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION02_POP_UP_STEALTH_DESCRIPTION"
msgid ""
"Animals can hear you, see you and even catch your scent. To avoid detection,"
" move slowly and conceal yourself in cover. Your scent can also force "
"animals to move away, even if it doesn’t fully spook them."
msgstr ""
"Zvěř vás může slyšet, vidět i navětřit. Postupujte pomalu a využívejte kryt."
" Váš pach ji může přimět k odchodu, i když se úplně nevyplaší."

#. Key:	KEY_TUTORIAL01_MISSION02_POP_UP_STEALTH_HEADLINE
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial 3 for beginners part23"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION02_POP_UP_STEALTH_HEADLINE"
msgid "Stealth"
msgstr "Plížení"

#. Key:	KEY_TUTORIAL01_MISSION02_POP_UP_TIERS_DESCRIPTION
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial 3 for beginners part21"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION02_POP_UP_TIERS_DESCRIPTION"
msgid ""
"Are you not sure which firearm or ammunition is best for hunting a specific "
"animal? Always compare the animal tier to the ammunition tier. If they "
"match, it’s a solid choice!"
msgstr ""
"Nevíte, jakou zbraň nebo střelivo zvolit pro konkrétní druh zvěře? "
"Porovnejte úroveň zvěře s úrovní střeliva. Když se shodují, je to dobrá "
"volba."

#. Key:	KEY_TUTORIAL01_MISSION02_POP_UP_TIERS_HEADLINE
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial 3 for beginners part20"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION02_POP_UP_TIERS_HEADLINE"
msgid "Animal and ammunition tiers"
msgstr "Úrovně zvířat a střeliva"

#. Key:	KEY_TUTORIAL01_MISSION02_POP_UP_TURKEY_SHOTGUN_DESCRIPTION
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes for us" : "added after 19.2. 2026"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt ""
"ST_Tutorial,KEY_TUTORIAL01_MISSION02_POP_UP_TURKEY_SHOTGUN_DESCRIPTION"
msgid ""
"When you hunt a turkey with a shotgun, aim at its head and neck for a proper"
" shot. The heart and lungs of turkeys are buried deep inside their body "
"cavity, and they are covered by feathers, bones and muscles, while the head "
"is completely uncovered and unprotected."
msgstr ""
"Při lovu krocana brokovnicí miřte na hlavu a krk. Srdce a plíce leží hluboko"
" v těle a chrání je peří, kosti i svaly. Hlava je oproti tomu nechráněná."

#. Key:	KEY_TUTORIAL01_MISSION02_POP_UP_TURKEY_SHOTGUN_HEADLINE
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes for us" : "added after 19.2. 2026"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION02_POP_UP_TURKEY_SHOTGUN_HEADLINE"
msgid "Turkey shotgun placement"
msgstr "Kam mířit při lovu krocana brokovnicí"

#. Key:	KEY_TUTORIAL01_MISSION02_VO01_L01_AITRAINER
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial 2 for beginners part21"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION02_VO01_L01_AITRAINER"
msgid ""
"In this training section, you’ll learn how to equip a firearm, how to "
"approach animals stealthily, and which calibers are appropriate for birds."
msgstr ""
"V této části výcviku se naučíte připravit střelnou zbraň, tiše podcházet "
"zvěř a vybrat vhodnou ráži pro lov pernaté zvěře."

#. Key:	KEY_TUTORIAL01_MISSION02_VO01_L02_AITRAINER
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial 2 for beginners part22"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION02_VO01_L02_AITRAINER"
msgid "We’ll begin by selecting the correct firearm."
msgstr "Začneme výběrem správné zbraně."

#. Key:	KEY_TUTORIAL01_MISSION02_VO02_2_L01_AITRAINER
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial 2 for beginners part24"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION02_VO02_2_L01_AITRAINER"
msgid "Select a large slot for the shotgun."
msgstr "Vyberte velký slot pro brokovnici."

#. Key:	KEY_TUTORIAL01_MISSION02_VO02_3_L01_AITRAINER
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial 2 for beginners part25"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION02_VO02_3_L01_AITRAINER"
msgid "Equip the shotgun in the slot."
msgstr "Vložte brokovnici do vybraného slotu."

#. Key:	KEY_TUTORIAL01_MISSION02_VO02_L01_AITRAINER
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial 2 for beginners part23"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION02_VO02_L01_AITRAINER"
msgid "You spooked the turkeys! Be more careful when you approach."
msgstr "Vyplašili jste krocany! Příště se přibližujte opatrněji."

#. Key:	KEY_TUTORIAL01_MISSION02_VO03_L01_AITRAINER
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial 2 for beginners part26"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION02_VO03_L01_AITRAINER"
msgid ""
"This is the Claim screen, where you can view information about your harvest,"
" see the Trophy you've scored, and review your shot placements."
msgstr ""
"Tohle je přehled úlovku. Ukáže vám údaje o ulovené zvěři, hodnocení trofeje "
"i místa zásahů."

#. Key:	KEY_TUTORIAL01_MISSION02_VO04_L01_AITRAINER
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial 2 for beginners part27"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION02_VO04_L01_AITRAINER"
msgid ""
"This is the Bullet camera. Here you can see the trajectory of projectiles "
"that hit the animal’s body."
msgstr "Toto je kamera zásahu. Uvidíte v ní dráhu střel, které zasáhly zvíře."

#. Key:	KEY_TUTORIAL01_MISSION02_VO04_L02_AITRAINER
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial 2 for beginners part28"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION02_VO04_L02_AITRAINER"
msgid ""
"You can rewind to watch the full path of the projectile and see whether your"
" shot was optimal or not."
msgstr ""
"Záznam můžete přetočit na začátek, sledovat celou dráhu střely a posoudit, "
"zda byl zásah správný."

#. Key:	KEY_TUTORIAL01_MISSION02_VO04_L03_AITRAINER
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial 2 for beginners part29"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION02_VO04_L03_AITRAINER"
msgid ""
"Since you used a shotgun, you’ll see the spread of projectiles inside the "
"animal’s body. If you used a rifle, you would see a bullet energy graph "
"instead."
msgstr ""
"Po zásahu brokovnicí vidíte rozptyl broků v těle zvěře. U kulovnice by se "
"zde místo toho zobrazil graf energie střely."

#. Key:	KEY_TUTORIAL01_MISSION02_VO04_L04_1_AITRAINER
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial 2 for beginners part31"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION02_VO04_L04_1_AITRAINER"
msgid ""
"You can view the bullet energy graph to see whether the energy of your shot "
"was optimal or not."
msgstr ""
"Na grafu energie střely můžete posoudit, zda byla energie při zásahu vhodná."

#. Key:	KEY_TUTORIAL01_MISSION02_VO04_L04_AITRAINER
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial 2 for beginners part30"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION02_VO04_L04_AITRAINER"
msgid "The Bullet camera changes depending on the type of ammunition you use."
msgstr "Zobrazení v kameře zásahu se mění podle použitého střeliva."

#. Key:	KEY_TUTORIAL01_MISSION02_VO05_L01_AITRAINER
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial 2 for beginners part32"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION02_VO05_L01_AITRAINER"
msgid ""
"Here you’ll review your Trophy score. For turkeys, the Trophy is presented "
"as its weight."
msgstr "Zde vidíte hodnocení trofeje. U krocana se vychází z jeho hmotnosti."

#. Key:	KEY_TUTORIAL01_MISSION02_VO05_L02_AITRAINER
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial 2 for beginners part33"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION02_VO05_L02_AITRAINER"
msgid ""
"You can see how many points it earned and how many stars it is worth—from "
"one star being the lowest up to five stars."
msgstr "Vidíte počet bodů a hodnocení od jedné do pěti hvězdiček."

#. Key:	KEY_TUTORIAL01_MISSION02_VO06_L01_AITRAINER
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial 2 for beginners part34"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION02_VO06_L01_AITRAINER"
msgid ""
"This section shows the animal’s weight before the harvest, how much weight "
"was lost due to the shot damage, and the time of harvest."
msgstr ""
"Zde je hmotnost zvířete před zpracováním, ztráta zvěřiny v důsledku zásahu a"
" čas ulovení."

#. Key:	KEY_TUTORIAL01_MISSION02_VO06_L02_AITRAINER
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
#. InfoMetaData:	"Notes Localization" : "Tutorial 2 for beginners part35"
#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION02_VO06_L02_AITRAINER"
msgid "The price per kilogram varies for each species."
msgstr "Cena za kilogram se u každého druhu liší."

#. Key:	KEY_TUTORIAL01_MISSION02_VO07_1_L01_10_AITRAINER
#. SourceLocation:	/Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
