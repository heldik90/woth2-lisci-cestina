msgctxt "ST_Encyclopedia,KEY_METAGAME_ENCYCLOPEDIA_GUIDE0303_NAME02"
msgid "Rifle sights and suppressors"
msgstr "Mířidla a tlumiče pušek"

#. Key:	KEY_METAGAME_ENCYCLOPEDIA_GUIDE0303_NAME04
#. SourceLocation:
#. /Game/BASE/UI/Display_Game/UiScreen_Codex/ST_Guides.ST_Guides
