#: /Game/BASE/Maps/Tutorial01/ST_Tutorials.ST_Tutorials
msgctxt "ST_Tutorial,KEY_TUTORIAL01_MISSION02_VO07_1_L01_10_AITRAINER"
msgid "Distances over 208 yards are generally safe when it comes to big game."
msgstr ""
"Na vzdálenost přes 208 yardů velká zvěř obvykle nezjistí vaši přítomnost."

