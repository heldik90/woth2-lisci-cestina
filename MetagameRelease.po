msgstr "Karakoram Plateau"

#. Key:	KEY_ENVIRONMENT_MAP03_LANDPUBLIC01_NAME
#. SourceLocation:	/Game/BASE/Maps/_Shared/ST_Levels.ST_Levels
#: /Game/BASE/Maps/_Shared/ST_Levels.ST_Levels
msgctxt "ST_Level,KEY_ENVIRONMENT_MAP03_LANDPUBLIC01_NAME"
msgid "Dzuteh Peak"
msgstr "Dzuteh Peak"

#. Key:	KEY_ENVIRONMENT_MAP03_LANDPUBLIC02_NAME
#. SourceLocation:	/Game/BASE/Maps/_Shared/ST_Levels.ST_Levels
#: /Game/BASE/Maps/_Shared/ST_Levels.ST_Levels
