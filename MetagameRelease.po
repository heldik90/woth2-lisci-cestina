msgid "American foxhound: your best companion"
msgstr "Americký foxhound: váš nejlepší společník"

#. Key:	KEY_METAGAME_ENCYCLOPEDIA_GUIDE10_NAME02
#. SourceLocation:
#. /Game/BASE/UI/Display_Game/UiScreen_Codex/ST_Guides.ST_Guides
#: /Game/BASE/UI/Display_Game/UiScreen_Codex/ST_Guides.ST_Guides
msgctxt "ST_Encyclopedia,KEY_METAGAME_ENCYCLOPEDIA_GUIDE10_NAME02"
msgid "Hunting aptitude"
msgstr "Lovecká vloha"

