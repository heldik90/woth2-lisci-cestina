#: /Game/BASE/UI/_Shared/ST_GameFlow.ST_GameFlow
msgctxt "ST_GameFlow,KEY_METAGAME_WARNINGS_BUYSTACKABLE"
msgid "We recommend to buy this in bundles."
msgstr "Doporučujeme zakoupit v balících."

#. Key:	KEY_METAGAME_WARNINGS_FULFILLOPPORTUNITY
#. SourceLocation:	/Game/BASE/UI/_Shared/ST_GameFlow.ST_GameFlow
#. InfoMetaData:   "Notes Localization" : "infrastructure warning 01: object
#. or player in the vicinity of where construction would occur"
#: /Game/BASE/UI/_Shared/ST_GameFlow.ST_GameFlow
msgctxt "ST_GameFlow,KEY_METAGAME_WARNINGS_FULFILLOPPORTUNITY"
msgid ""
"You can't build in this area. Make sure there are no obstacles that block "
"construction."
msgstr ""
"V tomto místě nelze stavět. Ověřte, že tu nejsou překážky, které brání "
"stavbě."

#. Key:	KEY_METAGAME_WARNINGS_ITEM_LOCKED
#. SourceLocation:	/Game/BASE/UI/_Shared/ST_GameFlow.ST_GameFlow
#. InfoMetaData:	"Notes Localization" : "Item warning 03"
#: /Game/BASE/UI/_Shared/ST_GameFlow.ST_GameFlow
msgctxt "ST_GameFlow,KEY_METAGAME_WARNINGS_ITEM_LOCKED"
msgid "Reach a higher level to buy this."
msgstr "K nákupu tohoto předmětu potřebujete vyšší úroveň."

#. Key:	KEY_METAGAME_WARNINGS_ITEM_PRICE
#. SourceLocation:	/Game/BASE/UI/_Shared/ST_GameFlow.ST_GameFlow
#. InfoMetaData:	"Notes Localization" : "Item warning 02"
#: /Game/BASE/UI/_Shared/ST_GameFlow.ST_GameFlow
msgctxt "ST_GameFlow,KEY_METAGAME_WARNINGS_ITEM_PRICE"
msgid "Earn more money to buy this."
msgstr "K nákupu tohoto předmětu potřebujete více peněz."

#. Key:	KEY_METAGAME_WARNINGS_LIMITS_PLACED
#. SourceLocation:	/Game/BASE/UI/_Shared/ST_GameFlow.ST_GameFlow
#. InfoMetaData:	"Notes Localization" : "Item warning 05"
#: /Game/BASE/UI/_Shared/ST_GameFlow.ST_GameFlow
msgctxt "ST_GameFlow,KEY_METAGAME_WARNINGS_LIMITS_PLACED"
msgid ""
"You can't place any more of this in the current reserve. Remove similar "
"objects first."
msgstr ""
"V této rezervaci už nemůžete umístit další předměty tohoto typu. Nejprve "
"odstraňte některé podobné předměty."

#. Key:	KEY_METAGAME_WARNINGS_LIMITS_STORAGE
#. SourceLocation:	/Game/BASE/UI/_Shared/ST_GameFlow.ST_GameFlow
#. InfoMetaData:	"Notes Localization" : "Item warning 12"
#: /Game/BASE/UI/_Shared/ST_GameFlow.ST_GameFlow
msgctxt "ST_GameFlow,KEY_METAGAME_WARNINGS_LIMITS_STORAGE"
msgid "Your storage is full. Sell or discard something from it."
msgstr "Váš sklad výbavy je plný. Některé předměty prodejte nebo vyřaďte."

#. Key:	KEY_METAGAME_WARNINGS_LOADOUT_APPLYING
#. SourceLocation:	/Game/BASE/UI/_Shared/ST_GameFlow.ST_GameFlow
#. InfoMetaData:	"Notes Localization" : "loadout warning 01"
#: /Game/BASE/UI/_Shared/ST_GameFlow.ST_GameFlow
msgctxt "ST_GameFlow,KEY_METAGAME_WARNINGS_LOADOUT_APPLYING"
msgid ""
"Do you want to apply the selected Loadout? All the currently equipped Gear "
"will be replaced."
msgstr ""
"Chcete použít vybranou sestavu výbavy? Nahradí veškerou výbavu, kterou máte "
"právě u sebe."

#. Key:	KEY_METAGAME_WARNINGS_LOADOUT_LIMIT
#. SourceLocation:	/Game/BASE/UI/_Shared/ST_GameFlow.ST_GameFlow
#. InfoMetaData:	"Notes Localization" : "loadout warning 03"
#: /Game/BASE/UI/_Shared/ST_GameFlow.ST_GameFlow
msgctxt "ST_GameFlow,KEY_METAGAME_WARNINGS_LOADOUT_LIMIT"
msgid ""
"You've reached the maximum number of Loadouts. Replace or remove an existing"
" Loadout to proceed."
msgstr ""
"Dosáhli jste nejvyššího počtu sestav výbavy. Chcete-li pokračovat, některou "
"sestavu nahraďte nebo smažte."

#. Key:	KEY_METAGAME_WARNINGS_LOADOUT_MISSING_ALL_ITEMS
#. SourceLocation:	/Game/BASE/UI/_Shared/ST_GameFlow.ST_GameFlow
#. InfoMetaData:	"Notes Localization" : "loadout warning 04"
#: /Game/BASE/UI/_Shared/ST_GameFlow.ST_GameFlow
msgctxt "ST_GameFlow,KEY_METAGAME_WARNINGS_LOADOUT_MISSING_ALL_ITEMS"
msgid ""
"You can't apply this Loadout. You are currently missing all Gear featured in"
" it."
msgstr ""
"Tuto sestavu výbavy nelze použít. Nevlastníte žádnou z věcí, které obsahuje."

#. Key:	KEY_METAGAME_WARNINGS_LOADOUT_MISSING_ITEMS
#. SourceLocation:	/Game/BASE/UI/_Shared/ST_GameFlow.ST_GameFlow
#. InfoMetaData:	"Notes Localization" : "loadout warning 05"
#: /Game/BASE/UI/_Shared/ST_GameFlow.ST_GameFlow
msgctxt "ST_GameFlow,KEY_METAGAME_WARNINGS_LOADOUT_MISSING_ITEMS"
msgid "You are currently missing some of the Gear featured in the Loadout."
msgstr "Některé věci z této sestavy výbavy momentálně nevlastníte."

#. Key:	KEY_METAGAME_WARNINGS_LOADOUT_REMOVING
#. SourceLocation:	/Game/BASE/UI/_Shared/ST_GameFlow.ST_GameFlow
#. InfoMetaData:	"Notes Localization" : "loadout warning 06"
#: /Game/BASE/UI/_Shared/ST_GameFlow.ST_GameFlow
msgctxt "ST_GameFlow,KEY_METAGAME_WARNINGS_LOADOUT_REMOVING"
msgid ""
"Do you want to remove the selected Loadout? You won't be able to restore it."
msgstr "Chcete smazat vybranou sestavu výbavy? Později ji už neobnovíte."

#. Key:	KEY_METAGAME_WARNINGS_MULTIPLAYER_FULLCAPACITY_GEAR
#. SourceLocation:	/Game/BASE/UI/_Shared/ST_GameFlow.ST_GameFlow
#. InfoMetaData:   "Notes Localization" : "multiplayer warning 02: blind/stand
#. is occupied by its maximum number of players"
#: /Game/BASE/UI/_Shared/ST_GameFlow.ST_GameFlow
msgctxt "ST_GameFlow,KEY_METAGAME_WARNINGS_MULTIPLAYER_FULLCAPACITY_GEAR"
msgid "You can't enter objects that are at full capacity."
msgstr "Do plně obsazených objektů nelze vstoupit."

#. Key:	KEY_METAGAME_WARNINGS_MULTIPLAYER_FULLCAPACITY_VEHICLES
#. SourceLocation:	/Game/BASE/UI/_Shared/ST_GameFlow.ST_GameFlow
#. InfoMetaData:   "Notes Localization" : "multiplayer warning 04: the vehicle
#. is occupied by its maximum number of players"
#: /Game/BASE/UI/_Shared/ST_GameFlow.ST_GameFlow
msgctxt "ST_GameFlow,KEY_METAGAME_WARNINGS_MULTIPLAYER_FULLCAPACITY_VEHICLES"
msgid "You can't enter vehicles that are at full capacity."
msgstr "Do plně obsazeného vozidla nelze nastoupit."

#. Key:	KEY_METAGAME_WARNINGS_MULTIPLAYER_HARVESTANIMALS
#. SourceLocation:	/Game/BASE/UI/_Shared/ST_GameFlow.ST_GameFlow
#. InfoMetaData:   "Notes Localization" : "multiplayer warning 01: animal was
#. fatally shot by another player"
#: /Game/BASE/UI/_Shared/ST_GameFlow.ST_GameFlow
msgctxt "ST_GameFlow,KEY_METAGAME_WARNINGS_MULTIPLAYER_HARVESTANIMALS"
msgid "You can't harvest this animal. Another player has a claim to it."
msgstr "Tento úlovek nemůžete zpracovat. Nárok na něj má jiný hráč."

#. Key:	KEY_METAGAME_WARNINGS_MULTIPLAYER_TEARDOWNGEAR_USED
#. SourceLocation:	/Game/BASE/UI/_Shared/ST_GameFlow.ST_GameFlow
#. InfoMetaData:   "Notes Localization" : "multiplayer warning 03: field gear
#. was placed by another player"
#: /Game/BASE/UI/_Shared/ST_GameFlow.ST_GameFlow
msgctxt "ST_GameFlow,KEY_METAGAME_WARNINGS_MULTIPLAYER_TEARDOWNGEAR_USED"
msgid "You can't pack up field gear that is currently used."
msgstr "Polní výbavu, kterou někdo právě používá, nemůžete sbalit."

#. Key:	KEY_METAGAME_WARNINGS_PLACEPLACEABLETERRAINRESTRICTION
#. SourceLocation:	/Game/BASE/UI/_Shared/ST_GameFlow.ST_GameFlow
#. InfoMetaData:	"Notes Localization" : "Item warning 04"
#: /Game/BASE/UI/_Shared/ST_GameFlow.ST_GameFlow
msgctxt "ST_GameFlow,KEY_METAGAME_WARNINGS_PLACEPLACEABLETERRAINRESTRICTION"
msgid ""
"You can't place this here. Look for a spot with flatter terrain and no "
"obstacles."
msgstr ""
"Tento předmět sem nemůžete umístit. Najděte místo s rovnějším terénem a bez "
"překážek."

#. Key:	KEY_METAGAME_WARNINGS_RETRIEVEPLACEABLE_FULLINVENTORY
#. SourceLocation:	/Game/BASE/UI/_Shared/ST_GameFlow.ST_GameFlow
#. InfoMetaData:	"Notes Localization" : "Item warning 07"
#: /Game/BASE/UI/_Shared/ST_GameFlow.ST_GameFlow
msgctxt "ST_GameFlow,KEY_METAGAME_WARNINGS_RETRIEVEPLACEABLE_FULLINVENTORY"
msgid "Your inventory is full. The object will be sent to your storage."
msgstr "Váš inventář je plný. Předmět se přesune do skladu výbavy."

#. Key:	KEY_METAGAME_WARNINGS_RETRIEVEPLACEABLE_FULLINVENTORY_NOSTORAGE
#. SourceLocation:	/Game/BASE/UI/_Shared/ST_GameFlow.ST_GameFlow
#. InfoMetaData:	"Notes Localization" : "Item warning 06"
#: /Game/BASE/UI/_Shared/ST_GameFlow.ST_GameFlow
msgctxt ""
"ST_GameFlow,KEY_METAGAME_WARNINGS_RETRIEVEPLACEABLE_FULLINVENTORY_NOSTORAGE"
msgid "You can't pack up field gear when there's no Inventory space for it."
msgstr "Polní výbavu nemůžete sbalit, pokud pro ni nemáte místo v inventáři."

#. Key:	KEY_METAGAME_WARNINGS_RETRIEVEPLACEABLE_FULLINVENTORYANDSTORAGE
#. SourceLocation:	/Game/BASE/UI/_Shared/ST_GameFlow.ST_GameFlow
#. InfoMetaData:	"Notes Localization" : "Item warning 08"
#: /Game/BASE/UI/_Shared/ST_GameFlow.ST_GameFlow
msgctxt ""
"ST_GameFlow,KEY_METAGAME_WARNINGS_RETRIEVEPLACEABLE_FULLINVENTORYANDSTORAGE"
msgid "Your inventory and storage are full. The object will be discarded."
msgstr "Váš inventář i sklad výbavy jsou plné. Předmět bude vyřazen."

#. Key:	KEY_METAGAME_WARNINGS_RETRIEVEPLACEABLE_INVALID
#. SourceLocation:	/Game/BASE/UI/_Shared/ST_GameFlow.ST_GameFlow
#. InfoMetaData:	"Notes Localization" : "Item warning 11"
#: /Game/BASE/UI/_Shared/ST_GameFlow.ST_GameFlow
msgctxt "ST_GameFlow,KEY_METAGAME_WARNINGS_RETRIEVEPLACEABLE_INVALID"
msgid "You can't pack up field gear that is marked as invalid."
msgstr "Polní výbavu označenou jako neplatnou nemůžete sbalit."

#. Key:	KEY_METAGAME_WARNINGS_RETRIEVEPLACEABLE_NOTOWNER
#. SourceLocation:	/Game/BASE/UI/_Shared/ST_GameFlow.ST_GameFlow
#. InfoMetaData:	"Notes Localization" : "Item warning 09"
#: /Game/BASE/UI/_Shared/ST_GameFlow.ST_GameFlow
msgctxt "ST_GameFlow,KEY_METAGAME_WARNINGS_RETRIEVEPLACEABLE_NOTOWNER"
msgid "You can't pack up field gear that doesn't belong to you."
msgstr "Polní výbavu, která vám nepatří, nemůžete sbalit."

#. Key:	KEY_METAGAME_WARNINGS_RETRIEVEPLACEABLE_TOOFAR
#. SourceLocation:	/Game/BASE/UI/_Shared/ST_GameFlow.ST_GameFlow
#. InfoMetaData:	"Notes Localization" : "Item warning 10"
#: /Game/BASE/UI/_Shared/ST_GameFlow.ST_GameFlow
msgctxt "ST_GameFlow,KEY_METAGAME_WARNINGS_RETRIEVEPLACEABLE_TOOFAR"
msgid "You can't pack up field gear when you're too far from it."
msgstr "Polní výbavu nemůžete sbalit, pokud jste od ní příliš daleko."

#. Key:	KEY_METAGAME_WARNINGS_SHOOTINGRANGE_TESTWEAPON_DISCARDED
#. SourceLocation:	/Game/BASE/UI/_Shared/ST_GameFlow.ST_GameFlow
#. InfoMetaData:   "Notes Localization" : "shooting range test item discarded
