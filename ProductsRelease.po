#: /Game/BASE/Gear/Attachments/_Shared/ST_Attachments.ST_Attachments
msgctxt "ST_Attachments,KEY_GEAR_ATTACHMENTS_SCOPE15_DESCRIPTION"
msgid "Long-range scope equipped with a large lens."
msgstr "Puškohled s velkým objektivem pro střelbu na velké vzdálenosti."

