msgctxt "ST_Attachments,KEY_GEAR_ATTACHMENTS_PROPERTIES_FOCALPLANE"
msgid "Focal plane"
msgstr "Ohnisková rovina"

#. Key:	KEY_GEAR_ATTACHMENTS_PROPERTIES_FOCALPLANE_FIRST_DESCRIPTION
#. SourceLocation:
#. /Game/BASE/Gear/Attachments/_Shared/ST_Attachments.ST_Attachments
#. InfoMetaData:   "Notes Localization" : "option for focal plane 01
#. description"
#: /Game/BASE/Gear/Attachments/_Shared/ST_Attachments.ST_Attachments
msgctxt ""
"ST_Attachments,KEY_GEAR_ATTACHMENTS_PROPERTIES_FOCALPLANE_FIRST_DESCRIPTION"
msgid ""
"The reticle is in front of the lenses and its size changes with "
"magnification. Suitable for long-range hunting and open terrain."
msgstr ""
"Záměrný kříž je před čočkami a jeho velikost se se zvětšením mění. Vhodné "
"pro lov na velké vzdálenosti a volný terén."

#. Key:	KEY_GEAR_ATTACHMENTS_PROPERTIES_FOCALPLANE_FIRST_NAME
#. SourceLocation:
#. /Game/BASE/Gear/Attachments/_Shared/ST_Attachments.ST_Attachments
#. InfoMetaData:	"Notes Localization" : "option for focal plane 01 name"
#: /Game/BASE/Gear/Attachments/_Shared/ST_Attachments.ST_Attachments
msgctxt "ST_Attachments,KEY_GEAR_ATTACHMENTS_PROPERTIES_FOCALPLANE_FIRST_NAME"
msgid "First"
msgstr "První"

#. Key:	KEY_GEAR_ATTACHMENTS_PROPERTIES_FOCALPLANE_SECOND_DESCRIPTION
#. SourceLocation:
#. /Game/BASE/Gear/Attachments/_Shared/ST_Attachments.ST_Attachments
#. InfoMetaData:   "Notes Localization" : "option for focal plane 02
#. description"
#: /Game/BASE/Gear/Attachments/_Shared/ST_Attachments.ST_Attachments
msgctxt ""
"ST_Attachments,KEY_GEAR_ATTACHMENTS_PROPERTIES_FOCALPLANE_SECOND_DESCRIPTION"
msgid ""
"The reticle is behind the lenses and its size doesn't change with "
"magnification. Suitable for short- and mid-range hunting in dense vegetation"
" as well as low-light conditions."
msgstr ""
"Záměrný kříž je za čočkami a jeho velikost se zvětšením nemění. Vhodné pro "
"lov na krátkou a střední vzdálenost v husté vegetaci i za zhoršených "
"světelných podmínek."

#. Key:	KEY_GEAR_ATTACHMENTS_PROPERTIES_FOCALPLANE_SECOND_NAME
#. SourceLocation:
#. /Game/BASE/Gear/Attachments/_Shared/ST_Attachments.ST_Attachments
#. InfoMetaData:	"Notes Localization" : "option for focal plane 02 name"
#: /Game/BASE/Gear/Attachments/_Shared/ST_Attachments.ST_Attachments
msgctxt ""
"ST_Attachments,KEY_GEAR_ATTACHMENTS_PROPERTIES_FOCALPLANE_SECOND_NAME"
msgid "Second"
msgstr "Druhá"

