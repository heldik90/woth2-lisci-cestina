#. Key:	KEY_GEAR_INFRASTRUCTURE_ZONE_FEEDING02_DESCRIPTION
#. SourceLocation:	/Game/BASE/Gear/_Shared/ST_Infrastructure.ST_Infrastructure
#. InfoMetaData:   "Notes Localization" : "Feeding habitat enhancement device
#. 02 description"
#: /Game/BASE/Gear/_Shared/ST_Infrastructure.ST_Infrastructure
msgctxt "ST_Infrastructure,KEY_GEAR_INFRASTRUCTURE_ZONE_FEEDING02_DESCRIPTION"
msgid "Place this spreader where smaller animals eat to feed them better."
msgstr "Umístěte rozmetadlo krmiva na místo, kde se krmí menší zvěř."

#. Key:	KEY_GEAR_INFRASTRUCTURE_ZONE_FEEDING02_NAME
#. SourceLocation:	/Game/BASE/Gear/_Shared/ST_Infrastructure.ST_Infrastructure
