#: /Game/BASE/Gear/_Shared/ST_Infrastructure.ST_Infrastructure
msgctxt "ST_Infrastructure,KEY_GEAR_INFRASTRUCTURE_ZONE_FEEDING01_DESCRIPTION"
msgid "Place this protected platform where birds eat to feed them better."
msgstr "Umístěte krytou krmnou plošinu na místo, kde se krmí ptáci."

