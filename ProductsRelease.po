#: /Game/BASE/Gear/Attachments/_Shared/ST_Attachments.ST_Attachments
msgctxt "ST_Attachments,KEY_GEAR_ATTACHMENTS_SCOPE13_DESCRIPTION"
msgid "Scope equipped with a small lens, intended for very close ranges."
msgstr "Puškohled s malým objektivem pro střelbu na velmi krátké vzdálenosti."

