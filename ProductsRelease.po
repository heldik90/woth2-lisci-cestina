msgctxt "ST_Weapons,KEY_GEAR_WEAPONS_RIFLEBOLT32_NAME"
msgid "Merkel HELIX Speedster"
msgstr "Merkel HELIX Speedster"

#. Key:	KEY_GEAR_WEAPONS_RIFLEBOLT33_NXTCOMPOSITE01_DESCRIPTION
