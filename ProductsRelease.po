#: /Game/BASE/Gear/Weapons/_Shared/ST_Weapons.ST_Weapons
msgctxt "ST_Weapons,KEY_GEAR_WEAPONS_RIFLEBOLT31_NAME"
msgid "Bergara Premier Elevate"
msgstr "Bergara Premier Elevate"

#. Key:	KEY_GEAR_WEAPONS_RIFLEBOLT32_DESCRIPTION
#. SourceLocation:	/Game/BASE/Gear/Weapons/_Shared/ST_Weapons.ST_Weapons
#. InfoMetaData:	"Notes Localization" : "riflebolt32 description"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Gear/Weapons/_Shared/ST_Weapons.ST_Weapons
msgctxt "ST_Weapons,KEY_GEAR_WEAPONS_RIFLEBOLT32_DESCRIPTION"
msgid ""
"This bolt-action rifle features an innovative system for exceptionally fast "
"follow-up shots. Stay on target while reloading with maximum speed. "
"Combining reliability, accuracy, and ergonomic handling, the HELIX is the "
"ideal companion for big-game hunting."
msgstr ""
"Tato opakovací kulovnice umožňuje díky inovativnímu systému mimořádně rychlé"
" další výstřely. Při rychlém přebíjení můžete stále sledovat cíl. "
"Spolehlivost, přesnost a snadné ovládání dělají z modelu HELIX výbornou "
"volbu pro lov velké zvěře."

#. Key:	KEY_GEAR_WEAPONS_RIFLEBOLT32_NAME
#. SourceLocation:	/Game/BASE/Gear/Weapons/_Shared/ST_Weapons.ST_Weapons
#. InfoMetaData:	"MetaData.Gather" : "False"
