#: /Game/BASE/Gear/Equipment/_Shared/ST_Ambushing.ST_Ambushing
msgctxt "ST_Ambushing,KEY_GEAR_AMBUSHING_BLIND01_NAME"
msgid "WildHeart Full Watcher"
msgstr "WildHeart Full Watcher"

