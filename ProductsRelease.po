msgstr "Primacy Vision Unity 1-4x24"

#. Key:	KEY_GEAR_ATTACHMENTS_SCOPE14_CUSTOM01_DESCRIPTION
#. SourceLocation:
#. /Game/BASE/Gear/Attachments/_Shared/ST_Attachments.ST_Attachments
#. InfoMetaData:   "Notes Localization" : "scope14_custom01
#. description\nchanged during localization"
