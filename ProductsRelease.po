msgid "Bergara B14² Crest Carbon"
msgstr "Bergara B14² Crest Carbon"

#. Key:	KEY_GEAR_WEAPONS_RIFLEBOLT27LIMITEDRESERVA_DESCRIPTION
#. SourceLocation:	/Game/BASE/Gear/Weapons/_Shared/ST_Weapons.ST_Weapons
