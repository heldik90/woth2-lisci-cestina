msgid "Strasser RS 700-22"
msgstr "Strasser RS 700-22"

#. Key:	KEY_GEAR_WEAPONS_RIFLEBOLT30_DESCRIPTION
#. SourceLocation:	/Game/BASE/Gear/Weapons/_Shared/ST_Weapons.ST_Weapons
#. InfoMetaData:   "Notes Localization" : "riflebolt30 description\nchanged
#. during localization batch 2"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Gear/Weapons/_Shared/ST_Weapons.ST_Weapons
msgctxt "ST_Weapons,KEY_GEAR_WEAPONS_RIFLEBOLT30_DESCRIPTION"
msgid ""
"Precision hunting rifle with sub-MOA accuracy, ergonomic handling, and "
"suppressor-ready performance. Designed for all-terrain versatility and "
"dependable field results. Suitable for medium-sized big game."
msgstr ""
"Přesná lovecká kulovnice s rozptylem pod jednu úhlovou minutu (MOA), "
"ergonomickým ovládáním a možností montáže tlumiče. Spolehlivá v každém "
"terénu, vhodná pro lov středně velké zvěře."

#. Key:	KEY_GEAR_WEAPONS_RIFLEBOLT30_NAME
#. SourceLocation:	/Game/BASE/Gear/Weapons/_Shared/ST_Weapons.ST_Weapons
