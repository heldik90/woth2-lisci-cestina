#. Key:	KEY_GEAR_BACKPACKLARGE01_DESCRIPTION
#. SourceLocation:	/Game/BASE/Characters/_Shared/ST_Backpacks.ST_Backpacks
#. InfoMetaData:   "Notes Localization" : "large backpack for hunters
#. description\nchanged during localization"
#: /Game/BASE/Characters/_Shared/ST_Backpacks.ST_Backpacks
msgctxt "ST_Backpacks,KEY_GEAR_BACKPACKLARGE01_DESCRIPTION"
msgid ""
"Larger backpack suitable for longer hunts. You'll make more noise when "
"moving with this than with a smaller backpack."
msgstr ""
"Větší batoh vhodný na delší lovy. Při pohybu s ním budete hlučnější než s "
"menším batohem."

#. Key:	KEY_GEAR_BACKPACKLARGE01_NAME
#. SourceLocation:	/Game/BASE/Characters/_Shared/ST_Backpacks.ST_Backpacks
#. InfoMetaData:	"MetaData.Gather" : "False"
#. InfoMetaData:	"Notes Localization" : "large backpack for hunters name"
#: /Game/BASE/Characters/_Shared/ST_Backpacks.ST_Backpacks
msgctxt "ST_Backpacks,KEY_GEAR_BACKPACKLARGE01_NAME"
msgid "WildHeart Journey"
msgstr "WildHeart Journey"

#. Key:	KEY_GEAR_BACKPACKMEDIUM01_DESCRIPTION
#. SourceLocation:	/Game/BASE/Characters/_Shared/ST_Backpacks.ST_Backpacks
#. InfoMetaData:   "Notes Localization" : "medium-sized backpack for hunters
#. description\nchanged during localization"
#: /Game/BASE/Characters/_Shared/ST_Backpacks.ST_Backpacks
msgctxt "ST_Backpacks,KEY_GEAR_BACKPACKMEDIUM01_DESCRIPTION"
msgid ""
"Medium-sized backpack suitable to carry any essential gear for shorter day "
"hunts."
msgstr ""
"Středně velký batoh na kratší denní lovy. Pojme veškeré nezbytné vybavení."

