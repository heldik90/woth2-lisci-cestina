msgid "Christensen Arms Evoke"
msgstr "Christensen Arms Evoke"

#. Key:	KEY_GEAR_WEAPONS_RIFLEBOLT31_DESCRIPTION
#. SourceLocation:	/Game/BASE/Gear/Weapons/_Shared/ST_Weapons.ST_Weapons
#. InfoMetaData:	"Notes Localization" : "riflebolt31 description"
#. InfoMetaData:	"Version" : "Beta"
#: /Game/BASE/Gear/Weapons/_Shared/ST_Weapons.ST_Weapons
msgctxt "ST_Weapons,KEY_GEAR_WEAPONS_RIFLEBOLT31_DESCRIPTION"
msgid ""
"Precision rifle featuring a Carbon Cure barrel, ultra-light MDT HNT26 "
"chassis and a TriggerTech trigger built on Bergara’s Premier action for high"
" accuracy in rugged conditions. Suitable for medium-sized big game."
msgstr ""
"Přesná kulovnice s hlavní Carbon Cure, ultralehkým šasi MDT HNT26 a spouští "
"TriggerTech. Závěrový systém Bergara Premier zajišťuje vysokou přesnost i v "
"náročných podmínkách. Hodí se k lovu středně velkých druhů velké zvěře."

#. Key:	KEY_GEAR_WEAPONS_RIFLEBOLT31_NAME
#. SourceLocation:	/Game/BASE/Gear/Weapons/_Shared/ST_Weapons.ST_Weapons
#. InfoMetaData:	"MetaData.Gather" : "False"
