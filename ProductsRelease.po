msgctxt "ST_Attachments,KEY_GEAR_ATTACHMENTS_CLIPONNVT01_DESCRIPTION"
msgid ""
"Clip-on device with a wide field of view suitable for short-distance "
"stalking in dense forests."
msgstr ""
"Předsádka se širokým zorným polem vhodná k šoulání na krátkou vzdálenost v "
"hustém lese."

