msgid "DD Optics V10 1.5-15x40 NXT"
msgstr "DD Optics V10 1.5-15x40 NXT"

#. Key:	KEY_GEAR_ATTACHMENTS_SCOPE17_DESCRIPTION
#. SourceLocation:
#. /Game/BASE/Gear/Attachments/_Shared/ST_Attachments.ST_Attachments
#. InfoMetaData:	"Notes Localization" : "scope17 description"
#: /Game/BASE/Gear/Attachments/_Shared/ST_Attachments.ST_Attachments
msgctxt "ST_Attachments,KEY_GEAR_ATTACHMENTS_SCOPE17_DESCRIPTION"
msgid ""
"This scope offers excellent situational awareness at low magnification, "
"making it perfect for fast mid-range target acquisition."
msgstr ""
"Při malém zvětšení poskytuje tento puškohled dobrý přehled o okolí a "
"umožňuje rychlé zaměření cílů na střední vzdálenost."

#. Key:	KEY_GEAR_ATTACHMENTS_SCOPE17_NAME
#. SourceLocation:
#. /Game/BASE/Gear/Attachments/_Shared/ST_Attachments.ST_Attachments
#. InfoMetaData:	"MetaData.Gather" : "False"
#. InfoMetaData:	"Notes Localization" : "scope17 name"
#: /Game/BASE/Gear/Attachments/_Shared/ST_Attachments.ST_Attachments
msgctxt "ST_Attachments,KEY_GEAR_ATTACHMENTS_SCOPE17_NAME"
msgid "ZEISS V8 1.8-14x50"
msgstr "ZEISS V8 1.8-14x50"

#. Key:	KEY_GEAR_ATTACHMENTS_SCOPE18_DESCRIPTION
#. SourceLocation:
#. /Game/BASE/Gear/Attachments/_Shared/ST_Attachments.ST_Attachments
#. InfoMetaData:	"Notes Localization" : "scope18 description"
#: /Game/BASE/Gear/Attachments/_Shared/ST_Attachments.ST_Attachments
msgctxt "ST_Attachments,KEY_GEAR_ATTACHMENTS_SCOPE18_DESCRIPTION"
msgid ""
"Versatile and performant scope suitable for waiting out dusk in a stand, "
"stalking wary game, or even lining up a long-range shot across open ground."
msgstr ""
"Všestranný puškohled pro čekanou na posedu za soumraku, šoulání za "
"ostražitou zvěří i střelbu na velkou vzdálenost v otevřeném terénu."

#. Key:	KEY_GEAR_ATTACHMENTS_SCOPE18_NAME
#. SourceLocation:
#. /Game/BASE/Gear/Attachments/_Shared/ST_Attachments.ST_Attachments
#. InfoMetaData:	"MetaData.Gather" : "False"
#. InfoMetaData:	"Notes Localization" : "scope18 name"
#: /Game/BASE/Gear/Attachments/_Shared/ST_Attachments.ST_Attachments
msgctxt "ST_Attachments,KEY_GEAR_ATTACHMENTS_SCOPE18_NAME"
msgid "ZEISS V8 2.8-20x56"
msgstr "ZEISS V8 2.8-20x56"

#. Key:	KEY_GEAR_ATTACHMENTS_SCOPE19_DESCRIPTION
#. SourceLocation:
#. /Game/BASE/Gear/Attachments/_Shared/ST_Attachments.ST_Attachments
#. InfoMetaData:	"Notes Localization" : "scope19 description"
#: /Game/BASE/Gear/Attachments/_Shared/ST_Attachments.ST_Attachments
msgctxt "ST_Attachments,KEY_GEAR_ATTACHMENTS_SCOPE19_DESCRIPTION"
msgid ""
"Custom long-range scope with mounting rings and a unique engraving. Intended"
" for experienced hunters."
msgstr ""
"Zakázkový puškohled pro střelbu na velké vzdálenosti s montážními kroužky a "
"jedinečnou rytinou. Určen zkušeným lovcům."

#. Key:	KEY_GEAR_ATTACHMENTS_SCOPE19_NAME
#. SourceLocation:
#. /Game/BASE/Gear/Attachments/_Shared/ST_Attachments.ST_Attachments
#. InfoMetaData:	"MetaData.Gather" : "False"
#. InfoMetaData:	"Notes Localization" : "scope19 name"
