msgstr "Hustší"

#. Key:	KEY_GEAR_ATTACHMENTS_PROPERTIES_PATTERNSPREAD_WIDER_DESCRIPTION
#. SourceLocation:
#. /Game/BASE/Gear/Attachments/_Shared/ST_Attachments.ST_Attachments
#: /Game/BASE/Gear/Attachments/_Shared/ST_Attachments.ST_Attachments
msgctxt ""
"ST_Attachments,KEY_GEAR_ATTACHMENTS_PROPERTIES_PATTERNSPREAD_WIDER_DESCRIPTION"
msgid ""
"Pellets spread out quickly. Suitable for fast-moving targets and close-range"
" shooting."
msgstr ""
"Broky se rychle rozptylují. Vhodné pro rychle se pohybující cíle a střelbu "
"na krátkou vzdálenost."

#. Key:	KEY_GEAR_ATTACHMENTS_PROPERTIES_PATTERNSPREAD_WIDER_NAME
